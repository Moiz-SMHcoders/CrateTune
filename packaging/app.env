# The app's identity — the ONE place to rename it.
#
# Read by crates/music-gpui/build.rs (exposed to the code as `identity::*`), by the
# packaging scripts (scripts/bundle-*.sh) and by CI. Plain KEY=VALUE lines, no spaces
# around `=`, no shell expansion. An original name has not been chosen yet; "Music"
# is the working name.
#
# APP_ID also names the settings directory and the keychain service; changing it
# starts with fresh settings (move the old directory to keep them).

# Display name: window title, menus, About, the .app / installer name.
APP_NAME=Music
# Lower-case id: config dir, keychain service, Linux app id / .desktop file, archive names.
APP_ID=music-macos
# macOS CFBundleIdentifier (reverse DNS).
BUNDLE_ID=io.github.music-macos
# One-line description (bundle metadata, .desktop Comment, installers).
APP_SUMMARY=Native desktop client for YouTube Music
# GitHub repository (owner/name) whose releases the in-app update check reads.
# Empty: no update check, and the Settings → About entry is hidden.
UPDATE_REPO=
