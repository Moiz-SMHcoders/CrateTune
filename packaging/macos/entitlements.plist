<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for Developer ID builds (scripts/bundle-macos.sh with
     MACOS_SIGN_IDENTITY). Ad-hoc builds don't use the hardened runtime. The app is not
     sandboxed (it reads music folders anywhere and uses the keychain). -->
<plist version="1.0">
<dict>
  <!-- Song recognition records from the microphone. -->
  <key>com.apple.security.device.audio-input</key><true/>
</dict>
</plist>
