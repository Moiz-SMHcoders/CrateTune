# Maintainer: Moiz-SMHcoders <https://github.com/Moiz-SMHcoders>
# Generated by scripts/update-packages.sh for v0.2.6; edit the script, not this file.
pkgname=cratetune
pkgver=0.2.6
_tag=0.2.6
pkgrel=1
pkgdesc="Native desktop client for YouTube Music"
arch=('x86_64')
url="https://github.com/Moiz-SMHcoders/CrateTune"
license=('GPL-3.0-only')
depends=('alsa-lib' 'fontconfig' 'freetype2' 'gcc-libs' 'glibc' 'hicolor-icon-theme' 'libx11' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'vulkan-icd-loader' 'wayland')
makedepends=('cargo' 'clang' 'pkgconf')
optdepends=('vulkan-driver: GPU rendering (vulkan-radeon, vulkan-intel or nvidia-utils)' 'org.freedesktop.secrets: keep sign-ins and API keys in the keyring (gnome-keyring, kwallet)')
source=("cratetune-$_tag.tar.gz::$url/archive/refs/tags/v$_tag.tar.gz")
sha256sums=('148cc6b282daa06a5a277b9927ade4ed71cc83423ba3375ec420c6d682b305f1')

prepare() {
  cd "CrateTune-$_tag"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "CrateTune-$_tag"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p music-gpui
  # The same tree as the release tarball (desktop file, icons, AppStream metadata).
  RELEASE_DATE="$(date -u -d "@${SOURCE_DATE_EPOCH:-$(date +%s)}" +%Y-%m-%d)" \
    scripts/bundle-linux.sh --no-build
}

package() {
  cd "CrateTune-$_tag/target/bundle/cratetune-$_tag-linux-$CARCH"
  install -Dm755 bin/cratetune "$pkgdir/usr/bin/cratetune"
  install -Dm644 share/applications/cratetune.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 share/metainfo/*.metainfo.xml -t "$pkgdir/usr/share/metainfo"
  local icon
  for icon in share/icons/hicolor/*/apps/cratetune.png; do
    install -Dm644 "$icon" "$pkgdir/usr/$icon"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # Tells CrateTune that pacman updates it, so the in-app updater stays off.
  install -dm755 "$pkgdir/usr/share/cratetune"
  printf 'aur\n' > "$pkgdir/usr/share/cratetune/packaged"
}
