# ---- Appearance
settings.appearance.theme = 主题
settings.appearance.theme_note = “动态”主题从正在播放曲目的封面中提取强调色（取最常见的鲜艳颜色，并加以调整，以确保在深色背景上清晰可读）。
settings.appearance.text_size = 文字大小
settings.appearance.font_scale = {percent}%
settings.appearance.text_size_note = 缩放所有界面文字；歌词使用其自身的大小设置（歌词）。
settings.appearance.background = 背景
settings.appearance.np_note = 渐变、纯色和光晕背景的颜色取自封面。光晕仅在播放音乐时流动。样式和背景也可以在“正在播放”界面的样式菜单中设置。
settings.appearance.np_fullscreen = 打开正在播放时进入全屏
settings.appearance.np_fullscreen_note = 打开“正在播放”或歌词时，窗口会进入全屏，关闭后退出全屏。原本就处于全屏的窗口保持不变。
settings.appearance.window_group = 窗口
settings.appearance.system_title_bar = 使用系统标题栏
settings.appearance.system_title_bar_note = 显示操作系统的标题栏，后退、前进和搜索放在页面上方，代替顶部栏。下次启动 {app} 时生效。
settings.appearance.title_bar_pending = 重启 {app} 以切换标题栏。
settings.appearance.mini_player = 迷你播放器

# ---- Playback
settings.playback.queue = 队列
settings.playback.shuffle = 随机播放
settings.playback.shuffle_desc = 当前歌曲保持在最前；关闭后恢复原有顺序。
settings.playback.repeat = 循环播放
settings.playback.repeat_desc = 重启后仍会保留（按 ⌘R 切换）。
settings.playback.repeat_all = 全部
settings.playback.repeat_one = 单曲
settings.playback.audio = 音频
settings.playback.streams = YouTube 音频流
settings.playback.stream_auto = 通过可用的最快途径获取完整歌曲：visionOS、TV 客户端，然后是 PoToken 客户端；连续失败 3 次的途径会被跳过 10 分钟。最后的办法：约 1 分钟的试听片段。
settings.playback.stream_tv = 通过 TV 客户端获取完整歌曲（无需 PoToken）；失败时使用试听片段。
settings.playback.stream_visionos = 通过 visionOS 客户端获取完整歌曲（直接链接：无需 PoToken，无需等待）；失败时使用试听片段。
settings.playback.stream_web = 通过网页客户端和 BotGuard PoToken 获取完整歌曲（macOS / Windows）；失败时使用试听片段。
settings.playback.stream_preview = 每首歌只播放前约 1 分钟（旧的行为）。
settings.playback.stream_status = 音频流途径
settings.playback.stream_status_none = 尚未播放过歌曲
settings.playback.stream_status_via = 上一首经由 {client}
settings.playback.stream_status_preview = 上一首：仅试听片段（所有途径均失败）
settings.playback.stream_status_skipped = 已跳过 {clients}，还剩 {minutes} 分钟
settings.playback.stream_status_fixes = 播放器修复 #{serial}
settings.playback.player_fixes = 播放器修复
settings.playback.player_fixes_desc = 当 YouTube 做出更改时，从 {app} 的 GitHub 仓库下载已签名的修复（仅数据，每 6 小时检查一次）。关闭：仅使用此版本内置的修复。
settings.playback.quality = 串流音质
settings.playback.quality_desc = “低”可节省流量；“高”优先使用 Opus（约 160 kbps）而非 AAC 128。
settings.playback.normalize = 响度标准化
settings.playback.normalize_desc = 根据 YouTube 的响度数据和 ReplayGain 标签平衡音量。
settings.playback.skip_silence = 跳过静音
settings.playback.skip_silence_desc = 去除曲目首尾的静音，并缩短较长的静音间隔。
settings.playback.auto_skip = 跳过播放失败的歌曲
settings.playback.auto_skip_desc = 继续播放下一首而不是停止（最多连续 3 首）。
settings.playback.transitions = 过渡
settings.playback.crossfade = 淡入淡出
settings.playback.crossfade_value = {seconds} 秒
settings.playback.transitions_note = 播放无缝衔接：下一首歌曲会提前约 30 秒缓冲，并紧接着上一个采样开始播放。淡入淡出会将两首歌曲混合过渡（试听片段提前结束前也会如此）。
settings.playback.speed_pitch = 速度与音高
settings.playback.speed = 速度
settings.playback.speed_value = {speed}×
settings.playback.pitch = 音高
settings.playback.pitch_value = {value} 半音
settings.playback.speed_pitch_note = 调整速度时音高不变；调整音高时速度不变。
settings.playback.output = 输出设备
settings.playback.system_default = 系统默认
settings.playback.device_missing = {device}（未连接）
settings.playback.device_current_default = {device}（当前默认）
settings.playback.playing_through = 正在通过 {device} 播放
settings.playback.output_note = 设备断开时会回退到系统默认设备，设备重新连接后会再次使用该设备。
settings.playback.sleep = 睡眠定时器
settings.playback.sleep_custom_button = {minutes} 分钟（自定义）
settings.playback.end_of_track = 本曲结束时
settings.playback.turn_off = 关闭
settings.playback.sleep_armed = 将暂停播放：{when}
settings.playback.custom_length = 自定义时长
settings.playback.sleep_note = 也可以在播放栏和“正在播放”界面中设置（月亮图标）。

# ---- Equalizer
settings.eq.preset.flat = 平直
settings.eq.preset.bass = 低音
settings.eq.preset.vocal = 人声
settings.eq.preset.treble = 高音
settings.eq.preset.loudness = 响度
settings.eq.note = 实时生效。增益会被自动补偿，因此输出永远不会削波。

# ---- Lyrics
settings.lyrics.look = 外观
settings.lyrics.animation = 动画
settings.lyrics.animation_note = 卡拉 OK：柔和扫过并抬起字词 · Apple：更宽的扫过效果，字词发光 · 滑动：清晰扫过，字词向上滑动 · 发光：已唱字词周围出现光晕 · 淡入：字词逐渐显现 · 无：整行点亮。字词动画需要逐字同步的歌词；逐行同步的歌词会点亮整行。
settings.lyrics.text_size = 文字大小
settings.lyrics.text_size_value = {size} px
settings.lyrics.line_spacing = 行距
settings.lyrics.line_spacing_value = {spacing}×
settings.lyrics.alignment = 对齐
settings.lyrics.bg_vocals = 和声与对唱
settings.lyrics.bg_vocals_desc = 和声显示在对应行的下方；第二位歌手显示在另一侧。
settings.lyrics.providers = 歌词来源
settings.lyrics.providers_note = 按此顺序查询（可同时查询多个）；采用最佳结果。在“正在播放”中点击某一行可跳转到该处；那里的重新加载按钮会再次搜索。
settings.lyrics.cached_only = 无密钥时仅限已缓存的歌曲
settings.lyrics.needs_key = 需要 API 密钥
settings.lyrics.prefer_word = 优先使用逐字同步歌词
settings.lyrics.prefer_word_desc = 逐字同步的结果优先于排在更前面的来源提供的逐行同步结果。
settings.lyrics.match_duration = 匹配歌曲的确切时长
settings.lyrics.match_duration_desc = 优先使用与歌曲时长相差不超过 2 秒的录音的歌词，避免电台版、加长混音或现场版错位。
settings.lyrics.waves = 分批询问来源
settings.lyrics.waves_desc = 先询问最快、最可靠的来源；只有它们没有良好的同步歌词时才询问其余来源。关闭：同时询问全部。
settings.lyrics.reset_order = 重置顺序
settings.lyrics.keys_note = API 密钥会在输入框失去焦点或按下回车键时保存到钥匙串。
settings.lyrics.translation = 翻译
settings.lyrics.translate = 翻译歌词
settings.lyrics.translate_desc = 在每行下方添加译文（也可使用“正在播放”中的翻译按钮）。
settings.lyrics.translator = 翻译服务
settings.lyrics.translator_ai = AI（兼容 OpenAI）
settings.lyrics.language = 语言
settings.lyrics.endpoint = 端点
settings.lyrics.model = 模型
settings.lyrics.api_key = API 密钥
settings.lyrics.translation_note = 语言代码，如 en、de、ja、zh-CN。每首歌针对每种语言和翻译服务只翻译一次，并保存在媒体库中。Google 的免费端点有频率限制：被拒绝后会暂停使用一段时间（2 分钟，如果持续被拒绝则更久），之后再重试翻译。
settings.lyrics.ai_missing = 请在“设置 → 歌词”中设置 AI 端点和模型。
settings.lyrics.romanization = 罗马音
settings.lyrics.romanization_note = 在使用以下文字的歌词行下方添加拉丁字母注音。
settings.lyrics.kanji = 汉字读音（日语）
settings.lyrics.kanji_embedded = 已内置于此版本。
settings.lyrics.kanji_missing = 如果没有它，汉字将保持原样，只有假名会被转为罗马音。只需下载一次 {download}（占用磁盘 {disk}）。
settings.lyrics.kanji_download = 下载（{size}）
settings.lyrics.kanji_downloading = 正在下载… {done} / {total}
settings.lyrics.kanji_ready = {name} · 占用磁盘 {size}。
settings.lyrics.kanji_failed = 下载失败：{error}

# ---- Queue sections & tabs, multi-select, logs, Together suggestions, devices
settings.playback.show_all_devices = 显示所有设备
settings.playback.show_all_devices_desc = 同时列出虚拟和重复的输出（Linux 上为 ALSA 的 dmix、surround、hw / plughw 等）。
settings.playback.devices_hidden.other = 已隐藏 {count} 个虚拟或重复的设备。
