# ---- Self-update (Settings → About → Updates, notifications, menu; src/update_check.rs,
# src/settings/about.rs). The older update.* keys are in settings_general.lang.

# Menu item (macOS: app menu under "About"; elsewhere: Help menu). Also a shortcut label.
menu.check_updates = 检查更新…

# Buttons. {version} = a version number such as 0.2.0.
update.update_to = 更新到 {version}
# Notification button: download and install the update that was found.
update.update_now = 更新
update.restart = 重新启动以完成
update.retry = 重试
# Opens the release page in the browser.
update.download_manually = 手动下载

# Status lines.
# {progress} = update.progress, or just the amount downloaded ("12.3 MB").
update.downloading = 正在下载 {version}… {progress}
# {done}, {total} = sizes such as "12.3 MB".
update.progress = {done} / {total}
update.ready = 版本 {version} 已下载并通过验证。重新启动即可完成更新。
update.installing = 正在安装 {version}…

# Switches.
update.auto_check = 自动检查更新
update.auto_check_detail = 在 {app} 启动时检查，运行期间每 24 小时检查一次。
update.auto_install = 自动安装更新
update.auto_install_detail = 在后台下载更新，然后提示你重新启动。如果你直接退出，更新会在退出时安装。
update.prereleases = 包括预发布版本
update.prereleases_detail = 在稳定版发布之前推出的测试版本。运行预发布版本（任何 0.x 版本）时默认开启。

# Notifications.
update.ready_toast = {app} {version} 已准备就绪。重新启动即可完成更新。
# {error} = one of the update.error.* messages.
update.failed_toast = 更新失败。{error}

# Errors, in plain words. "Nothing was installed" = the current version is unchanged.
# {error} = an English technical detail.
update.error.network = 无法连接到 GitHub（{error}）。请检查你的网络连接或代理。
update.error.bad_response = GitHub 返回了意外的响应（{error}）。
update.error.untrusted = 下载链接未指向本应用的 GitHub 版本发布页面，因此未打开。
update.error.no_asset = 此版本没有适用于你的系统的安装包。请手动下载。
update.error.no_checksums = 此版本没有校验和文件，因此无法验证下载内容。未安装任何内容。
update.error.not_listed = 此版本的校验和文件中未列出该安装包，因此无法验证。未安装任何内容。
update.error.mismatch = 下载内容与此版本的校验和不匹配。已将其删除，未安装任何内容。
update.error.cancelled = 下载已取消。
# {path} = a folder.
update.error.not_writable = 你的用户账户没有 {path} 的写入权限，因此 {app} 无法替换自身。请手动下载新版本。
update.error.dev_build = 此副本不是通过版本安装包安装的（例如从源代码构建），因此无法自行更新。
update.error.translocated = macOS 正在从临时的只读位置运行此副本。请将 {app} 移到“应用程序”文件夹，从那里打开后重试。
update.error.system_package = 此副本是通过软件包管理器安装的。请在软件包管理器中更新。
update.managed = 更新由 {manager} 提供。
update.managed_detail = {app} 是通过 {manager} 安装的，因此不会自行更新。请在 {manager} 中与其他应用一起更新。
update.error.invalid = 下载的安装包无效（{error}）。未安装任何内容。
update.error.io = 无法保存下载内容（{error}）。
update.error.install = 安装失败，当前版本保持不变（{error}）。
