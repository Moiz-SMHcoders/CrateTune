# Settings: Account, Network, About, settings panel, update check, sign-in window (Hindi).

# ---- Account
settings.account.cookie_title = ब्राउज़र कुकी से साइन इन करें
settings.account.cookie_steps = 1. अपने ब्राउज़र में music.youtube.com खोलें और साइन इन करें।\n2. डेवलपर टूल खोलें ({browsers} में {keys}) → Network, पेज रीलोड करें।\n3. music.youtube.com पर किसी भी अनुरोध (जैसे “browse”) पर क्लिक करें, Request Headers में “Cookie” ढूँढें और उसकी पूरी वैल्यू कॉपी करें।\n4. इसे नीचे पेस्ट करें। यह OS कीचेन में रखी जाती है और सिर्फ़ YouTube को भेजी जाती है।
settings.account.cookie_index = Google खाता इंडेक्स (अगर कई खातों से साइन इन है):
settings.account.not_signed_in = साइन इन नहीं है। सब कुछ बिना पहचान के काम करता है; साइन इन करने पर आपके पसंद किए गए गाने, सेव किए गए एल्बम, सब्सक्रिप्शन और प्लेलिस्ट लाइब्रेरी में सिंक होते हैं, और पसंद व प्लेलिस्ट में बदलाव YouTube Music पर वापस जाते हैं।
settings.account.sign_in_google = Google से साइन इन करें…
settings.account.paste_cookie = कुकी पेस्ट करें…
settings.account.google_refused = अगर Google साइन-इन विंडो को मना कर दे (“यह ब्राउज़र या ऐप सुरक्षित नहीं हो सकता”), तो “कुकी पेस्ट करें” इस्तेमाल करें।
settings.account.profile_note = साइन-इन विंडो अपनी अलग ब्राउज़र प्रोफ़ाइल रखती है, ताकि {app} बैकग्राउंड में आपका सत्र नवीनीकृत कर सके। साइन आउट करने पर यह हटा दी जाती है।
settings.account.last_synced = आखिरी सिंक {date}
settings.account.not_synced = अभी तक सिंक नहीं हुआ
settings.account.sync_now = अभी सिंक करें
settings.account.syncing = सिंक हो रहा है…
settings.account.sync_group = लाइब्रेरी सिंक
settings.account.sync_row = अपनी YouTube Music लाइब्रेरी सिंक करें
settings.account.sync_row_desc = पसंद किए गए गाने, लाइब्रेरी के गाने, सेव किए गए एल्बम, सब्सक्रिप्शन, प्लेलिस्ट।
settings.account.auto_sync = YouTube Music के साथ अपने-आप सिंक करें
settings.account.auto_sync_desc = शुरू होने पर, हर 45 मिनट और कुछ देर बाद लौटने पर: आपके पसंद किए गए गाने, और हर 6 घंटे पूरी लाइब्रेरी। आप जो गाना चलाते हैं, वह भी YouTube Music से अपनी पसंद या नापसंद ले लेता है।
settings.account.skip_disliked = नापसंद गाने छोड़ें
settings.account.skip_disliked_desc = चल रहे गाने को नापसंद करने पर अगला गाना चलता है। नापसंद गाने वैसे भी रेडियो और ऑटोप्ले से बाहर रहते हैं।
settings.account.accounts_group = खाते
settings.account.channels = इस Google खाते के चैनल (ब्रैंड खाते):
settings.account.google_index = Google खाता
settings.account.google_index_desc = आपके लॉगिन में कई Google खाते हो सकते हैं, जैसे youtube.com पर। चुनें कि {app} कौन-सा इस्तेमाल करे।
settings.account.google_single = इस लॉगिन में एक ही Google खाता है। कई खातों के लिए, ब्राउज़र में music.youtube.com पर हर खाते से साइन इन करें, फिर यहाँ साइन आउट करके उस ब्राउज़र की कुकी पेस्ट करें।
settings.account.cookie_note = साइन इन करने में music.youtube.com के लिए आपके ब्राउज़र की सेशन कुकी इस्तेमाल होती है। यह OS कीचेन में रखी जाती है और सिर्फ़ YouTube को भेजी जाती है। खाते की सुविधाएँ YouTube के वेब API के हिसाब से बनाई गई हैं, लेकिन अभी तक किसी असली खाते से जाँची नहीं गईं।

