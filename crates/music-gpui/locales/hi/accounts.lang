settings.account.from_browser = अपने ब्राउज़र से साइन इन करें…
settings.account.browser_note = “अपने ब्राउज़र से साइन इन करें” इस कंप्यूटर के किसी ब्राउज़र (Chrome, Edge, Brave, Firefox, Safari, Arc, Vivaldi, Opera, Chromium) का YouTube साइन-इन ले लेता है, इसलिए दोबारा साइन इन नहीं करना पड़ता।
settings.account.in_use = उपयोग में
settings.account.switch = स्विच करें
settings.account.remove = यह खाता हटाएँ
settings.account.list_group = आपके खाते
settings.account.add = खाता जोड़ें
settings.account.add_desc = किसी और YouTube Music खाते में साइन इन करें; यहाँ या टाइटल बार के खाता मेनू से उनके बीच स्विच करें।
settings.account.list_note = पसंद किए गाने, सहेजे एल्बम, सदस्यताएँ और YouTube प्लेलिस्ट उपयोग में चल रहे खाते की होती हैं और स्विच करने पर फिर से सिंक होती हैं। लोकल फ़ाइलें, लोकल प्लेलिस्ट, प्ले इतिहास और डाउनलोड सभी खातों में साझा होते हैं।
settings.account.report_plays = प्ले को मेरे YouTube इतिहास में जोड़ें
settings.account.report_plays_desc = यहाँ बजाए गाने आपके दूसरे डिवाइस पर YouTube Music इतिहास में दिखते हैं और सुझाव बेहतर बनाते हैं। सुनने का इतिहास रुका हो तो कुछ नहीं भेजा जाता।
browser_import.title = अपने ब्राउज़र से साइन इन करें
browser_import.intro = वह ब्राउज़र प्रोफ़ाइल चुनें जिसमें आप music.youtube.com में साइन इन हैं। {app} इस कंप्यूटर पर सिर्फ़ उसकी youtube.com कुकीज़ पढ़ता है और किसी भी साइन-इन की तरह उन्हें कीचेन में रखता है।
browser_import.note.keychain = macOS पूछेगा कि क्या {app} आपकी कीचेन से “<browser> Safe Storage” इस्तेमाल कर सकता है। यह अपेक्षित है: यह ब्राउज़र की कुकीज़ की कुंजी है। अनुमति दें चुनें।
browser_import.note.app_bound = नए Windows संस्करणों पर Chrome, Edge और Brave अपनी कुकीज़ को दूसरे ऐप से लॉक रखते हैं (ऐप-बाउंड एन्क्रिप्शन)। ऐसी प्रोफ़ाइल दिखती हैं पर पढ़ी नहीं जा सकतीं; इसके बजाय Firefox, “Google से साइन इन करें…” या चिपकाई गई कुकी इस्तेमाल करें।
browser_import.none_found = इस कंप्यूटर पर सहेजी कुकीज़ वाला कोई समर्थित ब्राउज़र नहीं मिला।
browser_import.import = आयात करें
browser_import.last_used = पिछली बार उपयोग {date}
browser_import.blocked.app_bound = ब्राउज़र ने लॉक किया है (ऐप-बाउंड एन्क्रिप्शन)
browser_import.blocked.no_key = ब्राउज़र की कुकी कुंजी नहीं मिली
browser_import.blocked.full_disk_access = पूर्ण डिस्क ऐक्सेस चाहिए (सिस्टम सेटिंग्स → गोपनीयता और सुरक्षा)
browser_import.reading = {browser} से YouTube साइन-इन पढ़ा जा रहा है…
browser_import.error.not_found = {browser} का कुकी स्टोर अब मौजूद नहीं है।
browser_import.error.locked = {browser} चलते समय अपनी कुकीज़ लॉक रखता है। {browser} बंद करके फिर कोशिश करें।
browser_import.error.full_disk_access = Safari की कुकीज़ पढ़ने के लिए {app} को पूर्ण डिस्क ऐक्सेस चाहिए: सिस्टम सेटिंग्स → गोपनीयता और सुरक्षा → पूर्ण डिस्क ऐक्सेस।
browser_import.error.permission = {app} को {browser} की कुकीज़ पढ़ने की अनुमति नहीं है।
browser_import.error.keychain = macOS ने {browser} की कुकीज़ की कुंजी “{browser} Safe Storage” नहीं दी। फिर कोशिश करें और macOS के पूछने पर अनुमति दें चुनें।
browser_import.error.no_key = {browser} की कुकीज़ की कुंजी नहीं मिली।
browser_import.error.app_bound = इस Windows संस्करण पर {browser} अपनी कुकीज़ दूसरे ऐप से लॉक रखता है (ऐप-बाउंड एन्क्रिप्शन)। इसके बजाय Firefox, “Google से साइन इन करें…” या चिपकाई गई कुकी इस्तेमाल करें।
browser_import.error.decrypt = {browser} की कुकीज़ डिक्रिप्ट नहीं हो सकीं।
browser_import.error.not_signed_in = {browser} ({profile}) YouTube में साइन इन नहीं है। पहले वहाँ music.youtube.com में साइन इन करें।
browser_import.error.format = {browser} का कुकी स्टोर पढ़ा नहीं जा सका।
