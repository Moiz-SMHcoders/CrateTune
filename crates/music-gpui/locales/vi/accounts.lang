account.list.no_saved_cookie = Không đọc được thông tin đăng nhập đã lưu của {name}. Hãy đăng nhập lại tài khoản đó.
titlebar.add_account = Thêm tài khoản…
settings.account.from_browser = Đăng nhập từ trình duyệt của bạn…
settings.account.browser_note = “Đăng nhập từ trình duyệt của bạn” lấy phiên đăng nhập YouTube của một trình duyệt trên máy này (Chrome, Edge, Brave, Firefox, Safari, Arc, Vivaldi, Opera, Chromium), nên bạn không cần đăng nhập lại.
settings.account.in_use = Đang dùng
settings.account.switch = Chuyển
settings.account.remove = Xóa tài khoản này
settings.account.list_group = Tài khoản của bạn
settings.account.add = Thêm tài khoản
settings.account.add_desc = Đăng nhập một tài khoản YouTube Music khác; chuyển giữa chúng tại đây hoặc từ menu tài khoản trên thanh tiêu đề.
settings.account.list_note = Bài hát đã thích, album đã lưu, kênh đăng ký và danh sách phát YouTube thuộc về tài khoản đang dùng và được đồng bộ lại khi bạn chuyển. Tệp cục bộ, danh sách phát cục bộ, lịch sử phát và nội dung tải xuống được dùng chung cho mọi tài khoản.
settings.account.report_plays = Thêm lượt phát vào lịch sử YouTube của tôi
settings.account.report_plays_desc = Những gì bạn phát ở đây sẽ xuất hiện trong lịch sử YouTube Music trên các thiết bị khác và giúp đề xuất tốt hơn. Không gửi gì khi lịch sử nghe đang tạm dừng.
browser_import.title = Đăng nhập từ trình duyệt của bạn
browser_import.intro = Chọn một hồ sơ trình duyệt đã đăng nhập music.youtube.com. {app} chỉ đọc cookie youtube.com của hồ sơ đó, trên máy này, và lưu chúng trong chuỗi khóa như mọi lần đăng nhập.
browser_import.note.keychain = macOS sẽ hỏi {app} có được dùng “<browser> Safe Storage” trong chuỗi khóa của bạn không. Điều này là bình thường: đó là khóa cho cookie của trình duyệt. Hãy chọn Cho phép.
browser_import.note.app_bound = Trên các bản Windows mới, Chrome, Edge và Brave khóa cookie cho riêng mình (mã hóa gắn với ứng dụng). Các hồ sơ đó vẫn được liệt kê nhưng không đọc được; hãy dùng Firefox, “Đăng nhập bằng Google…” hoặc dán cookie.
browser_import.none_found = Không tìm thấy trình duyệt được hỗ trợ có cookie đã lưu trên máy này.
browser_import.import = Nhập
browser_import.last_used = Dùng lần cuối {date}
browser_import.blocked.app_bound = Bị trình duyệt khóa (mã hóa gắn với ứng dụng)
browser_import.blocked.no_key = Không tìm thấy khóa cookie của trình duyệt
browser_import.blocked.full_disk_access = Cần quyền truy cập toàn bộ ổ đĩa (Cài đặt hệ thống → Quyền riêng tư & Bảo mật)
browser_import.reading = Đang đọc phiên đăng nhập YouTube từ {browser}…
browser_import.error.not_found = Kho cookie của {browser} không còn nữa.
browser_import.error.locked = {browser} khóa cookie khi đang chạy. Hãy thoát {browser} rồi thử lại.
browser_import.error.full_disk_access = {app} cần quyền truy cập toàn bộ ổ đĩa để đọc cookie của Safari: Cài đặt hệ thống → Quyền riêng tư & Bảo mật → Truy cập toàn bộ ổ đĩa.
browser_import.error.permission = {app} không được phép đọc cookie của {browser}.
browser_import.error.keychain = macOS chưa cấp “{browser} Safe Storage”, khóa cho cookie của {browser}. Hãy thử lại và chọn Cho phép khi macOS hỏi.
browser_import.error.no_key = Không tìm thấy khóa cho cookie của {browser}.
browser_import.error.app_bound = Trên bản Windows này, {browser} khóa cookie cho riêng mình (mã hóa gắn với ứng dụng), nên ứng dụng khác không đọc được. Hãy dùng Firefox, “Đăng nhập bằng Google…” hoặc dán cookie.
browser_import.error.decrypt = Không giải mã được cookie của {browser}.
browser_import.error.not_signed_in = {browser} ({profile}) chưa đăng nhập YouTube. Hãy đăng nhập music.youtube.com ở đó trước.
browser_import.error.format = Không đọc được kho cookie của {browser}.
