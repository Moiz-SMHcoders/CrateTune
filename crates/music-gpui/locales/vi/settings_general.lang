# ---- Account
settings.account.cookie_title = Đăng nhập bằng cookie trình duyệt
settings.account.cookie_steps = 1. Mở music.youtube.com trong trình duyệt và đăng nhập.\n2. Mở công cụ dành cho nhà phát triển (⌥⌘I trong Safari / Chrome) → Network, tải lại trang.\n3. Nhấp vào bất kỳ yêu cầu nào tới music.youtube.com (ví dụ “browse”), tìm “Cookie” trong Request Headers và sao chép toàn bộ giá trị.\n4. Dán vào bên dưới. Cookie được lưu trong chuỗi khóa của hệ điều hành và chỉ được gửi tới YouTube.
settings.account.cookie_index = Chỉ số tài khoản Google (nếu đăng nhập nhiều tài khoản):
settings.account.not_signed_in = Chưa đăng nhập. Mọi thứ đều hoạt động ẩn danh; khi đăng nhập, bài hát đã thích, album đã lưu, kênh đã đăng ký và danh sách phát sẽ được đồng bộ vào thư viện, còn lượt thích và chỉnh sửa danh sách phát sẽ được gửi lại YouTube Music.
settings.account.sign_in_google = Đăng nhập bằng Google…
settings.account.paste_cookie = Dán cookie…
settings.account.google_refused = Nếu Google từ chối cửa sổ đăng nhập (“Trình duyệt hoặc ứng dụng này có thể không an toàn”), hãy dùng “Dán cookie”.
settings.account.last_synced = Đồng bộ lần cuối {date}
settings.account.not_synced = Chưa đồng bộ
settings.account.sync_now = Đồng bộ ngay
settings.account.syncing = Đang đồng bộ…
settings.account.sync_group = Đồng bộ thư viện
settings.account.sync_row = Đồng bộ thư viện YouTube Music của bạn
settings.account.sync_row_desc = Bài hát đã thích, bài hát trong thư viện, album đã lưu, kênh đã đăng ký, danh sách phát.
settings.account.auto_sync = Tự động đồng bộ với YouTube Music
settings.account.auto_sync_desc = Khi khởi động, mỗi 45 phút và khi bạn quay lại sau một lúc: các bài hát đã thích, và toàn bộ thư viện mỗi 6 giờ. Bài hát bạn phát cũng lấy trạng thái thích hoặc không thích từ YouTube Music.
settings.account.skip_disliked = Bỏ qua bài hát bạn không thích
settings.account.skip_disliked_desc = Đánh dấu không thích bài đang phát sẽ chuyển sang bài tiếp theo. Bài hát không thích luôn bị loại khỏi radio và tự động phát.
settings.account.accounts_group = Tài khoản
settings.account.channels = Các kênh (tài khoản thương hiệu) của tài khoản Google này:
settings.account.google_index = Tài khoản Google
settings.account.google_index_desc = Phiên đăng nhập của bạn có thể chứa nhiều tài khoản Google, như trên youtube.com. Chọn tài khoản {app} sẽ dùng.
settings.account.google_single = Phiên đăng nhập này chỉ có một tài khoản Google. Để dùng nhiều tài khoản, hãy đăng nhập từng tài khoản trên music.youtube.com trong trình duyệt, rồi đăng xuất ở đây và dán cookie của trình duyệt đó.
settings.account.cookie_note = Việc đăng nhập dùng cookie phiên trình duyệt của bạn cho music.youtube.com. Cookie được giữ trong chuỗi khóa của hệ điều hành và chỉ được gửi tới YouTube. Các tính năng tài khoản được xây dựng dựa trên API web của YouTube nhưng chưa được kiểm chứng với tài khoản thật.

