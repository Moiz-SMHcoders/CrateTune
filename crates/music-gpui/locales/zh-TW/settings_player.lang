prefs.placeholder.asset = 素材鍵或 URL
prefs.placeholder.button_label = 標籤

# ---- Appearance
settings.appearance.theme = 主題
settings.appearance.theme_note = 「動態」主題會從正在播放曲目的封面擷取強調色（取最常見的鮮豔色彩，並加以調整，確保在深色背景上清楚易讀）。
settings.appearance.text_size = 文字大小
settings.appearance.font_scale = {percent}%
settings.appearance.text_size_note = 縮放所有介面文字；歌詞使用自己的大小設定（歌詞）。
settings.appearance.background = 背景
settings.appearance.np_note = 漸層、純色和光暈背景的色彩取自封面。光暈只會在播放音樂時流動。樣式和背景也能在「正在播放」畫面的樣式選單中設定。
settings.appearance.np_fullscreen = 開啟正在播放時進入全螢幕
settings.appearance.np_fullscreen_note = 開啟「正在播放」或歌詞時，視窗會進入全螢幕，關閉後結束全螢幕。原本就是全螢幕的視窗會維持不變。
settings.appearance.window_group = 視窗
settings.appearance.system_title_bar = 使用系統標題列
settings.appearance.system_title_bar_note = 顯示作業系統的標題列，上一頁、下一頁和搜尋放在頁面上方，取代頂部列。下次啟動 {app} 時生效。
settings.appearance.title_bar_pending = 重新啟動 {app} 以切換標題列。
settings.appearance.mini_player = 迷你播放器

# ---- Playback
settings.playback.queue = 佇列
settings.playback.shuffle = 隨機播放
settings.playback.shuffle_desc = 目前的歌曲會保持在最前面；關閉後會恢復原本的順序。
settings.playback.repeat = 重複播放
settings.playback.repeat_desc = 重新啟動後仍會保留（按 ⌘R 切換）。
settings.playback.repeat_all = 全部
settings.playback.repeat_one = 單曲
settings.playback.audio = 音訊
settings.playback.streams = YouTube 串流
settings.playback.stream_auto = 完整歌曲：先用 TV 用戶端，再用搭配 PoToken 的網頁用戶端，最後改用約 1 分鐘的試聽片段。
settings.playback.stream_tv = 透過 TV 用戶端取得完整歌曲（不需要 PoToken）；失敗時改用試聽片段。
settings.playback.stream_web = 透過網頁用戶端和 BotGuard PoToken 取得完整歌曲（macOS / Windows）；失敗時改用試聽片段。
settings.playback.stream_preview = 每首歌只播放前約 1 分鐘（舊的行為）。
settings.playback.quality = 串流品質
settings.playback.quality_desc = 「低」可節省數據用量；「高」會優先使用 Opus（約 160 kbps）而非 AAC 128。
settings.playback.normalize = 音量平衡
settings.playback.normalize_desc = 依據 YouTube 的響度資料和 ReplayGain 標籤平衡音量。
settings.playback.skip_silence = 略過靜音
settings.playback.skip_silence_desc = 移除曲目開頭和結尾的靜音，並縮短較長的靜音間隔。
settings.playback.auto_skip = 略過無法載入的歌曲
settings.playback.auto_skip_desc = 繼續播放下一首而不是停止（最多連續 3 首）。
settings.playback.transitions = 轉場
settings.playback.crossfade = 交叉淡化
settings.playback.crossfade_value = {seconds} 秒
settings.playback.transitions_note = 播放無間斷：下一首歌曲會提前約 30 秒緩衝，並緊接著上一個取樣開始播放。交叉淡化會讓兩首歌曲混合轉場（試聽片段提前結束前也會如此）。
settings.playback.speed_pitch = 速度與音高
settings.playback.speed = 速度
settings.playback.speed_value = {speed}×
settings.playback.pitch = 音高
settings.playback.pitch_value = {value} 半音
settings.playback.speed_pitch_note = 調整速度時音高不變；調整音高時速度不變。
settings.playback.output = 輸出裝置
settings.playback.system_default = 系統預設
settings.playback.device_missing = {device}（未連線）
settings.playback.device_current_default = {device}（目前的預設值）
settings.playback.playing_through = 正在透過 {device} 播放
settings.playback.output_note = 裝置中斷連線時會改用系統預設裝置，裝置重新連線後會再次使用它。
settings.playback.sleep = 睡眠計時器
settings.playback.sleep_custom_button = {minutes} 分鐘（自訂）
settings.playback.end_of_track = 本曲結束時
settings.playback.turn_off = 關閉
settings.playback.sleep_armed = 將暫停播放：{when}
settings.playback.custom_length = 自訂長度
settings.playback.sleep_note = 也能在播放列和「正在播放」畫面中設定（月亮圖示）。

# ---- Equalizer
settings.eq.preset.flat = 平坦
settings.eq.preset.bass = 低音
settings.eq.preset.vocal = 人聲
settings.eq.preset.treble = 高音
settings.eq.preset.loudness = 響度
settings.eq.note = 即時套用。增益會自動補償，因此輸出絕不會削波失真。

# ---- Lyrics
settings.lyrics.look = 外觀
settings.lyrics.animation = 動畫
settings.lyrics.animation_note = 卡拉 OK：柔和掃過並浮起字詞 · Apple：較寬的掃過效果，字詞發光 · 滑動：清晰掃過，字詞向上滑動 · 發光：已唱字詞周圍出現光暈 · 淡入：字詞逐漸浮現 · 無：整行亮起。字詞動畫需要逐字同步的歌詞；逐行同步的歌詞會讓整行亮起。
settings.lyrics.text_size = 文字大小
settings.lyrics.text_size_value = {size} px
settings.lyrics.line_spacing = 行距
settings.lyrics.line_spacing_value = {spacing}×
settings.lyrics.alignment = 對齊
settings.lyrics.bg_vocals = 和聲與對唱
settings.lyrics.bg_vocals_desc = 和聲顯示在對應行的下方；第二位歌手顯示在另一側。
settings.lyrics.providers = 歌詞來源
settings.lyrics.providers_note = 依此順序查詢（可同時查詢多個）；採用最佳結果。在「正在播放」中點選某一行即可跳轉到該處；那裡的重新載入按鈕會再次搜尋。
settings.lyrics.cached_only = 沒有金鑰時僅限已快取的歌曲
settings.lyrics.needs_key = 需要 API 金鑰
settings.lyrics.prefer_word = 優先使用逐字同步歌詞
settings.lyrics.prefer_word_desc = 逐字同步的結果會優先於排序較前的來源所提供的逐行同步結果。
settings.lyrics.reset_order = 重設順序
settings.lyrics.keys_note = API 金鑰會在欄位失去焦點或按下 Enter 鍵時儲存到鑰匙圈。
settings.lyrics.translation = 翻譯
settings.lyrics.translate = 翻譯歌詞
settings.lyrics.translate_desc = 在每行下方加入譯文（也可使用「正在播放」中的翻譯按鈕）。
settings.lyrics.translator = 翻譯服務
settings.lyrics.translator_ai = AI（與 OpenAI 相容）
settings.lyrics.language = 語言
settings.lyrics.endpoint = 端點
settings.lyrics.model = 模型
settings.lyrics.api_key = API 金鑰
settings.lyrics.translation_note = 語言代碼，例如 en、de、ja、zh-CN。每首歌針對每種語言和翻譯服務只會翻譯一次，並保存在媒體庫中。Google 的免費端點有頻率限制：遭到拒絕後會暫停使用一段時間（2 分鐘，若持續遭拒則更久），之後再重試翻譯。
settings.lyrics.ai_missing = 請在「設定 → 歌詞」中設定 AI 端點和模型。
settings.lyrics.romanization = 羅馬拼音
settings.lyrics.romanization_note = 在使用以下文字的歌詞行下方加入拉丁字母拼音。
settings.lyrics.kanji = 漢字讀音（日文）
settings.lyrics.kanji_embedded = 已內建於此版本。
settings.lyrics.kanji_missing = 如果沒有它，漢字會保持原樣，只有假名會轉為羅馬拼音。只需下載一次 {download}（佔用磁碟 {disk}）。
settings.lyrics.kanji_download = 下載（{size}）
settings.lyrics.kanji_downloading = 正在下載… {done} / {total}
settings.lyrics.kanji_ready = {name} · 佔用磁碟 {size}。
settings.lyrics.kanji_failed = 下載失敗：{error}
