# ---- Self-update (Settings → About → Updates, notifications, menu; src/update_check.rs,
# src/settings/about.rs). The older update.* keys are in settings_general.lang.

# Menu item (macOS: app menu under "About"; elsewhere: Help menu). Also a shortcut label.
menu.check_updates = 檢查更新…

# Buttons. {version} = a version number such as 0.2.0.
update.update_to = 更新至 {version}
# Notification button: download and install the update that was found.
update.update_now = 更新
update.restart = 重新啟動以完成
update.retry = 重試
# Opens the release page in the browser.
update.download_manually = 手動下載

# Status lines.
# {progress} = update.progress, or just the amount downloaded ("12.3 MB").
update.downloading = 正在下載 {version}… {progress}
# {done}, {total} = sizes such as "12.3 MB".
update.progress = {done} / {total}
update.ready = 版本 {version} 已下載並通過驗證。重新啟動即可完成更新。
update.installing = 正在安裝 {version}…

# Switches.
update.auto_check = 自動檢查更新
update.auto_check_detail = 在 {app} 啟動時檢查，執行期間每 24 小時檢查一次。
update.auto_install = 自動安裝更新
update.auto_install_detail = 在背景下載更新，然後提示你重新啟動。如果你直接結束，更新會在結束時安裝。
update.prereleases = 包含預先發布版本
update.prereleases_detail = 在穩定版發布前推出的測試版本。執行預先發布版本（任何 0.x 版本）時預設為開啟。

# Notifications.
update.ready_toast = {app} {version} 已準備就緒。重新啟動即可完成更新。
# {error} = one of the update.error.* messages.
update.failed_toast = 更新失敗。{error}

# Errors, in plain words. "Nothing was installed" = the current version is unchanged.
# {error} = an English technical detail.
update.error.network = 無法連線至 GitHub（{error}）。請檢查你的網際網路連線或代理伺服器。
update.error.bad_response = GitHub 傳回了非預期的回應（{error}）。
update.error.untrusted = 下載連結並未指向本應用程式的 GitHub 版本發布頁面，因此未開啟。
update.error.no_asset = 此版本沒有適用於你系統的安裝套件。請手動下載。
update.error.no_checksums = 此版本沒有檢查碼檔案，因此無法驗證下載內容。未安裝任何項目。
update.error.not_listed = 此版本的檢查碼檔案未列出此安裝套件，因此無法驗證。未安裝任何項目。
update.error.mismatch = 下載內容與此版本的檢查碼不符。已將其刪除，未安裝任何項目。
update.error.cancelled = 已取消下載。
# {path} = a folder.
update.error.not_writable = 你的使用者帳號無法寫入 {path}，因此 {app} 無法取代自身。請手動下載新版本。
update.error.dev_build = 此副本並非透過版本安裝套件安裝（例如從原始碼建置），因此無法自行更新。
update.error.translocated = macOS 正從暫時的唯讀位置執行此副本。請將 {app} 移至「應用程式」資料夾，從該處打開後再試一次。
update.error.system_package = 此副本是透過套件管理工具安裝的。請在套件管理工具中更新。
update.error.invalid = 下載的安裝套件無效（{error}）。未安裝任何項目。
update.error.io = 無法儲存下載內容（{error}）。
update.error.install = 安裝失敗，目前的版本保持不變（{error}）。
