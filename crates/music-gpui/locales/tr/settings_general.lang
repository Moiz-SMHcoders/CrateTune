# Settings: Account, Network, About, panel, update check, sign-in window (Turkish).

# ---- Account
settings.account.cookie_title = Tarayıcı çereziyle oturum aç
settings.account.cookie_steps = 1. Tarayıcınızda music.youtube.com adresini açın ve oturum açın.\n2. Geliştirici araçlarını açın ({browsers}'da {keys}) → Network, sayfayı yeniden yükleyin.\n3. music.youtube.com'a giden herhangi bir isteğe tıklayın (ör. “browse”), Request Headers altında “Cookie” satırını bulun ve değerinin tamamını kopyalayın.\n4. Aşağıya yapıştırın. İşletim sisteminin anahtar zincirinde saklanır ve yalnızca YouTube'a gönderilir.
settings.account.cookie_index = Google hesabı dizini (birden fazla hesapta oturum açıksa):
settings.account.not_signed_in = Oturum açılmadı. Her şey anonim olarak çalışır; oturum açmak beğendiğiniz şarkıları, kaydedilen albümleri, abonelikleri ve çalma listelerini kitaplığa eşitler; beğeniler ve çalma listesi düzenlemeleri de YouTube Music'e geri gönderilir.
settings.account.sign_in_google = Google ile oturum aç…
settings.account.paste_cookie = Çerez yapıştır…
settings.account.google_refused = Google oturum açma penceresini reddederse (“Bu tarayıcı veya uygulama güvenli olmayabilir”), “Çerez yapıştır” seçeneğini kullanın.
settings.account.last_synced = Son eşitleme: {date}
settings.account.not_synced = Henüz eşitlenmedi
settings.account.sync_now = Şimdi eşitle
settings.account.syncing = Eşitleniyor…
settings.account.sync_group = Kitaplık eşitleme
settings.account.sync_row = YouTube Music kitaplığınızı eşitleyin
settings.account.sync_row_desc = Beğenilen şarkılar, kitaplık şarkıları, kaydedilen albümler, abonelikler, çalma listeleri.
settings.account.accounts_group = Hesaplar
settings.account.channels = Bu Google hesabının kanalları (marka hesapları):
settings.account.google_index = Google hesabı
settings.account.google_index_desc = Oturumunuz youtube.com’daki gibi birden fazla Google hesabı içerebilir. {app} uygulamasının hangisini kullanacağını seçin.
settings.account.google_single = Bu oturumda tek bir Google hesabı var. Birden fazlasını kullanmak için bir tarayıcıda music.youtube.com’da her birine giriş yapın, ardından burada çıkış yapıp o tarayıcının çerezini yapıştırın.
settings.account.cookie_note = Oturum açmak, music.youtube.com için tarayıcı oturum çerezinizi kullanır. Çerez işletim sisteminin anahtar zincirinde saklanır ve yalnızca YouTube'a gönderilir. Hesap özellikleri YouTube'un web API'sine göre geliştirildi ancak henüz gerçek bir hesapla doğrulanmadı.

