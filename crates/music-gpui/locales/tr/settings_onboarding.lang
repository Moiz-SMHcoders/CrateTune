# ---- Welcome step: feature list
onboarding.feature.browse.title = Göz atma ve arama
onboarding.feature.browse.text = Ana sayfa akışı, listeler, ruh halleri, yeni çıkanlar, sanatçılar, albümler ve çalma listeleri.
onboarding.feature.lyrics.title = Şarkı sözleri
onboarding.feature.lyrics.text = Birçok sağlayıcıdan kelime kelime eşzamanlı sözler; çeviri ve Latin harflerine aktarma ile.
onboarding.feature.library.title = Kitaplık
onboarding.feature.library.text = Beğeniler, çalma listeleri, dinleme geçmişi, istatistikler ve indirilenler — bu bilgisayarda saklanır.
onboarding.feature.recognize.title = Müzik tanıma
onboarding.feature.recognize.text = Çevrenizde çalan bir şarkıyı tanıyın (⇧⌘R) ve hemen çalın.

