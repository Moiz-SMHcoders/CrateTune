# ---- Self-update (Settings → About → Updates, notifications, menu; src/update_check.rs,
# src/settings/about.rs). The older update.* keys are in settings_general.lang.

# Menu item (macOS: app menu under "About"; elsewhere: Help menu). Also a shortcut label.
menu.check_updates = Güncellemeleri Denetle…

# Buttons. {version} = a version number such as 0.2.0.
update.update_to = {version} sürümüne güncelle
# Notification button: download and install the update that was found.
update.update_now = Güncelle
update.restart = Bitirmek için yeniden başlat
update.retry = Yeniden dene
# Opens the release page in the browser.
update.download_manually = El ile indir

# Status lines.
# {progress} = update.progress, or just the amount downloaded ("12.3 MB").
update.downloading = {version} indiriliyor… {progress}
# {done}, {total} = sizes such as "12.3 MB".
update.progress = {done} / {total}
update.ready = {version} sürümü indirildi ve doğrulandı. Güncellemeyi bitirmek için yeniden başlatın.
update.installing = {version} yükleniyor…

# Switches.
update.auto_check = Güncellemeleri otomatik olarak denetle
update.auto_check_detail = {app} açıldığında ve çalıştığı sürece 24 saatte bir.
update.auto_install = Güncellemeleri otomatik olarak yükle
update.auto_install_detail = Güncellemeleri arka planda indirir ve yeniden başlatmanızı ister. Bunun yerine çıkarsanız güncelleme o sırada yüklenir.
update.prereleases = Ön sürümleri dahil et
update.prereleases_detail = Kararlı sürümden önce yayımlanan test sürümleri. Bir ön sürüm (herhangi bir 0.x sürümü) kullanırken varsayılan olarak açıktır.

# Notifications.
update.ready_toast = {app} {version} hazır. Güncellemeyi bitirmek için yeniden başlatın.
# {error} = one of the update.error.* messages.
update.failed_toast = Güncelleme başarısız oldu. {error}

# Errors, in plain words. "Nothing was installed" = the current version is unchanged.
# {error} = an English technical detail.
update.error.network = GitHub'a ulaşılamadı ({error}). İnternet bağlantınızı veya proxy ayarlarınızı denetleyin.
update.error.bad_response = GitHub beklenmeyen bir yanıt gönderdi ({error}).
update.error.untrusted = İndirme bağlantısı bu uygulamanın GitHub sürümlerine yönlendirmediği için açılmadı.
update.error.no_asset = Bu sürümde sisteminiz için bir paket yok. El ile indirin.
update.error.no_checksums = Bu sürümün sağlama toplamı dosyası yok, bu nedenle indirilen dosya doğrulanamıyor. Hiçbir şey yüklenmedi.
update.error.not_listed = Sürümün sağlama toplamı dosyasında bu paket yer almıyor, bu nedenle doğrulanamıyor. Hiçbir şey yüklenmedi.
update.error.mismatch = İndirilen dosya sürümün sağlama toplamıyla eşleşmiyor. Dosya silindi ve hiçbir şey yüklenmedi.
update.error.cancelled = İndirme iptal edildi.
# {path} = a folder.
update.error.not_writable = Kullanıcınızın {path} konumuna yazma izni olmadığı için {app} kendini değiştiremiyor. Yeni sürümü el ile indirin.
update.error.dev_build = Bu kopya bir sürüm paketinden yüklenmedi (örneğin kaynak koddan derlendi), bu nedenle kendini güncelleyemiyor.
update.error.translocated = macOS bu kopyayı geçici ve salt okunur bir konumdan çalıştırıyor. {app} uygulamasını Uygulamalar klasörüne taşıyın, oradan açın ve yeniden deneyin.
update.error.system_package = Bu kopya bir paket yöneticisiyle yüklendi. Güncellemeyi oradan yapın.
update.error.invalid = İndirilen paket geçerli değil ({error}). Hiçbir şey yüklenmedi.
update.error.io = İndirilen dosya kaydedilemedi ({error}).
update.error.install = Yükleme başarısız oldu; mevcut sürüm yerinde duruyor ({error}).
