# ---- Appearance
settings.appearance.theme = Тема
settings.appearance.theme_note = Динамічна тема бере акцентний колір з обкладинки поточного треку (найпоширеніший яскравий колір, скоригований, щоб залишатися читабельним на темному тлі).
settings.appearance.text_size = Розмір тексту
settings.appearance.font_scale = {percent} %
settings.appearance.text_size_note = Масштабує весь текст інтерфейсу; тексти пісень мають власний розмір («Тексти пісень»).
settings.appearance.background = Тло
settings.appearance.np_note = Градієнт, суцільний колір і сяйво беруть кольори з обкладинки. Сяйво рухається лише під час відтворення. Дизайн і тло також є в меню макета на екрані «Зараз грає».
settings.appearance.np_fullscreen = Повний екран під час відкриття «Зараз грає»
settings.appearance.np_fullscreen_note = Відкриття екрана «Зараз грає» або тексту пісні переводить вікно в повноекранний режим, а закриття виходить із нього. Вікно, яке вже було в повноекранному режимі, таким і залишиться.
settings.appearance.mini_player = Мініплеєр

# ---- Playback
settings.playback.queue = Черга
settings.playback.shuffle = Перемішування
settings.playback.shuffle_desc = Поточна пісня залишається першою; після вимкнення порядок відновлюється.
settings.playback.repeat = Повтор
settings.playback.repeat_desc = Запам'ятовується між запусками (⌘R перемикає режим).
settings.playback.repeat_all = Усі
settings.playback.repeat_one = Одна
settings.playback.audio = Аудіо
settings.playback.streams = Потоки YouTube
settings.playback.stream_auto = Повні пісні: TV-клієнт, потім вебклієнт з PoToken, потім фрагмент ~1 хв.
settings.playback.stream_tv = Повні пісні через TV-клієнт (без PoToken); фрагмент, якщо не вдасться.
settings.playback.stream_web = Повні пісні через вебклієнт і PoToken від BotGuard (macOS); фрагмент, якщо не вдасться.
settings.playback.stream_preview = Лише перша ~1 хвилина кожної пісні (стара поведінка).
settings.playback.quality = Якість потоку
settings.playback.quality_desc = «Низька» заощаджує трафік; «Висока» надає перевагу Opus (~160 кбіт/с) над AAC 128.
settings.playback.normalize = Нормалізація гучності
settings.playback.normalize_desc = Вирівнює гучність за даними YouTube і тегами ReplayGain.
settings.playback.skip_silence = Пропускати тишу
settings.playback.skip_silence_desc = Прибирає тишу на краях треків і скорочує довгі паузи.
settings.playback.auto_skip = Пропускати пісні, що не завантажуються
settings.playback.auto_skip_desc = Переходить до наступної замість зупинки (до 3 поспіль).
settings.playback.transitions = Переходи
settings.playback.crossfade = Плавний перехід
settings.playback.crossfade_value = {seconds} с
settings.playback.transitions_note = Відтворення без пауз: наступна пісня буферизується приблизно на 30 с наперед і починається з наступного ж семплу. Плавний перехід змішує дві пісні (також перед раннім завершенням фрагмента).
settings.playback.speed_pitch = Швидкість і висота тону
settings.playback.speed = Швидкість
settings.playback.speed_value = {speed}×
settings.playback.pitch = Висота тону
settings.playback.pitch_value = {value} пт
settings.playback.speed_pitch_note = Зміна швидкості зберігає висоту тону; зміна висоти тону зберігає швидкість.
settings.playback.output = Пристрій виводу
settings.playback.system_default = Як у системі
settings.playback.device_missing = {device} (не підключено)
settings.playback.device_current_default = {device} (зараз типовий)
settings.playback.playing_through = Відтворення через {device}
settings.playback.output_note = Якщо пристрій відсутній, використовується системний типовий; щойно пристрій повернеться, його буде вибрано знову.
settings.playback.sleep = Таймер сну
settings.playback.sleep_custom_button = {minutes} хв (власний)
settings.playback.end_of_track = До кінця треку
settings.playback.turn_off = Вимкнути
settings.playback.sleep_armed = Пауза: {when}
settings.playback.custom_length = Власна тривалість
settings.playback.sleep_note = Також на панелі плеєра й на екрані «Зараз грає» (значок місяця).

# ---- Equalizer
settings.eq.preset.flat = Рівний
settings.eq.preset.bass = Баси
settings.eq.preset.vocal = Вокал
settings.eq.preset.treble = Високі
settings.eq.preset.loudness = Гучність
settings.eq.note = Застосовується наживо. Підсилення компенсується, тож вихідний сигнал ніколи не перевантажується.

# ---- Lyrics
settings.lyrics.look = Вигляд
settings.lyrics.animation = Анімація
settings.lyrics.animation_note = Караоке: м'яке заповнення з піднятими словами · Apple: ширше заповнення, сяйне слово · Зсув: різке заповнення, слова зсуваються вгору · Сяйво: ореол навколо проспіваних слів · Поява: слова плавно з'являються · Немає: рядок підсвічується. Анімації слів потребують текстів із синхронізацією за словами; у текстах із синхронізацією за рядками підсвічується весь рядок.
settings.lyrics.text_size = Розмір тексту
settings.lyrics.text_size_value = {size} пкс
settings.lyrics.line_spacing = Міжрядковий інтервал
settings.lyrics.line_spacing_value = {spacing}×
settings.lyrics.alignment = Вирівнювання
settings.lyrics.bg_vocals = Бек-вокал і дуети
settings.lyrics.bg_vocals_desc = Бек-вокал під його рядком; другий виконавець з іншого боку.
settings.lyrics.providers = Джерела
settings.lyrics.providers_note = Опитуються в цьому порядку (кілька одночасно); перемагає найкращий результат. Клацніть рядок у «Зараз грає», щоб перемотати; кнопка перезавантаження там шукає знову.
settings.lyrics.cached_only = без ключа — лише кешовані пісні
settings.lyrics.needs_key = потрібен ключ API
settings.lyrics.prefer_word = Надавати перевагу синхронізації за словами
settings.lyrics.prefer_word_desc = Результат із синхронізацією за словами переважає результат за рядками від джерела, що стоїть вище.
settings.lyrics.reset_order = Скинути порядок
settings.lyrics.keys_note = Ключі API зберігаються у сховищі ключів, коли поле втрачає фокус або після натискання Enter.
settings.lyrics.translation = Переклад
settings.lyrics.translate = Перекладати тексти
settings.lyrics.translate_desc = Додає перекладений рядок під кожним рядком (також кнопка перекладу в «Зараз грає»).
settings.lyrics.translator = Перекладач
settings.lyrics.translator_ai = ШІ (OpenAI-сумісний)
settings.lyrics.language = Мова
settings.lyrics.endpoint = Кінцева точка
settings.lyrics.model = Модель
settings.lyrics.api_key = Ключ API
settings.lyrics.translation_note = Коди мов на зразок en, de, ja, zh-CN. Кожна пісня перекладається один раз для кожної мови й перекладача та зберігається в бібліотеці. Безкоштовна кінцева точка Google має обмеження частоти запитів: після відмови її на деякий час залишають у спокої (2 хв, довше, якщо відмови тривають), а потім пробують перекласти знову.
settings.lyrics.ai_missing = Укажіть кінцеву точку й модель ШІ в «Налаштування → Тексти пісень».
settings.lyrics.romanization = Транслітерація
settings.lyrics.romanization_note = Додає рядок латиницею під рядками цими писемностями.
settings.lyrics.kanji = Читання кандзі (японська)
settings.lyrics.kanji_embedded = Вбудовано в цю версію.
settings.lyrics.kanji_missing = Без нього кандзі залишаються як є, а транслітеруються лише кана. Завантажується один раз: {download} ({disk} на диску).
settings.lyrics.kanji_download = Завантажити ({size})
settings.lyrics.kanji_downloading = Завантаження… {done} з {total}
settings.lyrics.kanji_ready = {name} · {size} на диску.
settings.lyrics.kanji_failed = Не вдалося завантажити: {error}
