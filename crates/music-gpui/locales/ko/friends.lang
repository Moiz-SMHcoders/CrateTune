# Friend groups (see locales/en/friends.lang).

# The Settings section's name.
settings.section.friends = 친구

# ---- Settings → Friends
settings.friends.title = 친구 그룹
settings.friends.intro = 매번 새 Music Together 방을 만드는 대신 친구 그룹을 유지하세요. 친구들이 듣고 있는 음악을 보고 클릭 한 번으로 그룹 전체와 세션을 시작할 수 있습니다.
settings.friends.enabled = 친구 그룹 사용
settings.friends.enabled_desc = 기본적으로 꺼져 있습니다. 켜면 내 컴퓨터가 친구들의 컴퓨터와 종단 간 암호화로 직접 통신합니다.
settings.friends.privacy = 친구에게 보이는 정보: 내 이름과, 공유가 켜져 있는 동안에만 재생 중인 노래(제목, 아티스트, YouTube ID, 재생 시작 시각). 서버에는 아무것도 저장되지 않습니다. 릴레이는 암호화된 데이터를 전달하기만 하며 내 IP 주소만 볼 수 있습니다. 그룹은 각 멤버의 컴퓨터에 저장됩니다.

settings.friends.you = 나
settings.friends.name = 이름
settings.friends.name_note = 친구들에게 표시되는 내 이름입니다.
settings.friends.share = 듣고 있는 음악 공유
settings.friends.share_desc = 내가 재생하는 노래가 친구들의 피드에 표시됩니다. 내 파일의 노래는 공유되지 않습니다.
settings.friends.private = 비공개 세션
settings.friends.private_desc = 앱을 종료할 때까지 공유를 일시 중지합니다.
settings.friends.member_id = 멤버 ID: {id}

settings.friends.groups = 내 그룹
settings.friends.no_groups = 아직 그룹이 없습니다. 그룹을 만들어 친구를 초대하거나, 친구가 보여 주는 코드로 그룹에 참여하세요.
settings.friends.you_name = {name}(나)
settings.friends.owner = 소유자
settings.friends.remove = 내보내기
settings.friends.invite = 초대
settings.friends.leave = 나가기
settings.friends.invite_shown = 친구가 설정 → 친구 → 그룹 참여에서 이 코드를 입력하면 됩니다:
settings.friends.invite_expires = 10분 동안 한 번만 유효합니다. 다른 네트워크에서는 대신 링크를 보내거나 QR 코드를 스캔하게 하세요.
settings.friends.create = 그룹 만들기
settings.friends.group_placeholder = 그룹 이름
settings.friends.create_button = 만들기
settings.friends.join = 그룹 참여
settings.friends.join_button = 참여
settings.friends.join_note = 멤버가 보여 주는 코드 또는 보내 준 초대 링크.
settings.friends.joining = 그룹을 찾는 중…
settings.friends.joined = {group}에 참여함

settings.friends.recovery = 복구 문구
settings.friends.recovery_note = 친구들은 이 컴퓨터에 저장된 키로 나를 알아봅니다. 복구 문구를 적어 두면 이 키를 새 컴퓨터로 옮길 수 있습니다. 복구 문구를 가진 사람은 누구나 나로 행세할 수 있습니다.
settings.friends.show_phrase = 복구 문구 표시
settings.friends.hide_phrase = 숨기기
settings.friends.copy_phrase = 복사
settings.friends.restore = 복구 문구로 복원
settings.friends.phrase_placeholder = XXXXX-XXXXX-…
settings.friends.restore_button = 복원
settings.friends.restore_note = 이 컴퓨터의 키를 대체합니다. 이 컴퓨터에서는 그룹이 삭제됩니다. 각 그룹의 멤버(또는 이전 컴퓨터)에게 초대를 요청하면 같은 이름으로 돌아갈 수 있습니다.

# ---- Joining errors
friends.join.not_found = 이 네트워크에서 초대를 표시하는 사람을 찾지 못했습니다. 친구가 다른 네트워크에 있으면 초대 링크를 요청하세요.
friends.join.wrong_code = 코드가 일치하지 않습니다. 확인한 후 다시 시도하세요.
friends.join.not_inviting = 해당 초대는 더 이상 유효하지 않습니다. 새 초대를 요청하세요.
friends.join.failed = 참여하지 못했습니다: {error}
friends.join.bad_code = 초대 코드가 아닙니다. 코드는 ABCD-2345처럼 영문자와 숫자 8자입니다.

# ---- Notifications
friends.toast.not_ready = 친구 기능이 아직 준비되지 않았습니다. 잠시 후 다시 시도하세요.
friends.toast.created = “{group}” 그룹을 만들었습니다. 코드로 친구를 초대하세요.
friends.toast.removed = “{group}”에서 내보내졌습니다.
friends.toast.listen_invite = {name} 님이 {group} 그룹과 함께 듣기를 시작했습니다
friends.toast.listen_sent = 세션을 시작하는 중입니다. 준비되면 그룹에 초대가 전송됩니다.
friends.toast.joined = “{group}”에 참여함
friends.toast.member_joined = {name} 님이 “{group}”에 참여함
friends.toast.bad_phrase = 올바른 복구 문구가 아닙니다. 각 문자 그룹을 확인하세요.
friends.toast.restored = 키를 복원했습니다. 그룹 초대를 요청하세요.

# ---- The feed (Listen together page)
friends.feed.playing = 지금 재생 중
friends.feed.paused = 일시정지됨 · {ago}
friends.feed.idle = 재생 중인 항목 없음 · {ago}
friends.feed.unknown = 아직 소식 없음
friends.feed.song = {title} — {artist}

# ---- The friends card on the Listen together page
friends.panel.title = 친구
friends.panel.off = 친구들과 계속 함께할 그룹을 만드세요. 친구들이 듣고 있는 음악을 보고 클릭 한 번으로 함께 세션을 시작할 수 있습니다.
friends.panel.set_up = 친구 그룹 설정
friends.panel.invite = {name} 님이 {group} 세션을 시작함
friends.panel.join = 참여
friends.panel.no_friends = 아직 친구가 없습니다. 설정 → 친구에서 그룹을 만들어 초대하세요.
friends.panel.listen = 함께 듣기: {group}
friends.panel.sharing = 친구들이 내가 재생하는 음악을 볼 수 있습니다.
friends.panel.not_sharing = 재생 중인 음악을 공유하고 있지 않습니다.
friends.panel.manage = 그룹…

friends.panel.listen_mode = {mode} 모드로 시작하거나, 그룹 세션이 진행 중이면 그 세션에 참여합니다
friends.panel.listen_how = 먼저 모드 선택…
friends.panel.session_here = {group} 그룹과 함께 듣는 중
friends.toast.auto_joining = {group} 그룹에서 {name} 님의 세션에 참여하는 중…
settings.friends.group_mode = 함께 듣기 모드
