# ---- Appearance
settings.appearance.theme = Тема
settings.appearance.theme_note = «Динамическая» берёт акцентный цвет из обложки текущего трека (самый частый яркий цвет, подстроенный для читаемости на тёмном фоне).
settings.appearance.text_size = Размер текста
settings.appearance.font_scale = {percent} %
settings.appearance.text_size_note = Масштабирует весь текст интерфейса; у текстов песен свой размер (раздел «Тексты песен»).
settings.appearance.background = Фон
settings.appearance.np_note = Градиент, сплошной цвет и свечение берут цвета из обложки. Свечение движется только во время воспроизведения. Оформление и фон также можно выбрать в меню экрана «Сейчас играет».
settings.appearance.np_fullscreen = Полный экран при открытии «Сейчас играет»
settings.appearance.np_fullscreen_note = При открытии экрана «Сейчас играет» или текста песни окно переходит в полноэкранный режим, а при закрытии выходит из него. Окно, которое уже было в полноэкранном режиме, таким и останется.
settings.appearance.window_group = Окно
settings.appearance.system_title_bar = Системная строка заголовка
settings.appearance.system_title_bar_note = Показывает строку заголовка системы, а «назад», «вперёд» и поиск — над страницей, вместо верхней панели. Действует со следующего запуска {app}.
settings.appearance.title_bar_pending = Перезапустите {app}, чтобы сменить строку заголовка.
settings.appearance.mini_player = Мини-плеер

# ---- Playback
settings.playback.queue = Очередь
settings.playback.shuffle = Перемешивание
settings.playback.shuffle_desc = Текущий трек остаётся первым; при выключении порядок восстанавливается.
settings.playback.repeat = Повтор
settings.playback.repeat_desc = Запоминается между запусками (⌘R переключает режим).
settings.playback.repeat_all = Все
settings.playback.repeat_one = Один
settings.playback.audio = Звук
settings.playback.streams = Потоки YouTube
settings.playback.stream_auto = Полные треки самым быстрым рабочим способом: visionOS, TV-клиент, затем клиенты с PoToken; способ, давший сбой 3 раза подряд, пропускается на 10 мин. Крайний случай — превью ~1 мин.
settings.playback.stream_tv = Полные треки через TV-клиент (без PoToken); при ошибке — превью.
settings.playback.stream_visionos = Полные треки через клиент visionOS (прямые ссылки: без PoToken и ожидания); при ошибке — превью.
settings.playback.stream_web = Полные треки через веб-клиент и PoToken от BotGuard (macOS / Windows); при ошибке — превью.
settings.playback.stream_preview = Только первая ~1 минута каждого трека (старое поведение).
settings.playback.stream_status = Способ получения потока
settings.playback.stream_status_none = Пока ни один трек не воспроизводился
settings.playback.stream_status_via = Последний трек через {client}
settings.playback.stream_status_preview = Последний трек: только превью (все способы не сработали)
settings.playback.stream_status_skipped = {clients}: пропуск ещё {minutes} мин
settings.playback.stream_status_fixes = исправления плеера № {serial}
settings.playback.player_fixes = Исправления плеера
settings.playback.player_fixes_desc = Когда YouTube что-то меняет, загружать подписанные исправления (только данные, проверка каждые 6 ч) из репозитория {app} на GitHub. Выкл.: только исправления, встроенные в эту версию.
settings.playback.quality = Качество потока
settings.playback.quality_desc = «Низкое» экономит трафик; «Высокое» предпочитает Opus (~160 кбит/с) вместо AAC 128.
settings.playback.normalize = Нормализация громкости
settings.playback.normalize_desc = Выравнивает громкость по данным YouTube и тегам ReplayGain.
settings.playback.skip_silence = Пропускать тишину
settings.playback.skip_silence_desc = Убирает тишину в начале и конце трека и сокращает длинные паузы.
settings.playback.auto_skip = Пропускать треки, которые не загружаются
settings.playback.auto_skip_desc = Переходит к следующему вместо остановки (до 3 подряд).
settings.playback.transitions = Переходы
settings.playback.crossfade = Плавный переход
settings.playback.crossfade_value = {seconds} с
settings.playback.transitions_note = Воспроизведение без пауз: следующий трек буферизуется примерно за 30 с и начинается сразу со следующего сэмпла. Плавный переход смешивает два трека (в том числе перед досрочным окончанием превью).
settings.playback.speed_pitch = Скорость и тон
settings.playback.speed = Скорость
settings.playback.speed_value = {speed}×
settings.playback.pitch = Тон
settings.playback.pitch_value = {value} пт
settings.playback.speed_pitch_note = Скорость не меняет тон; тон не меняет скорость.
settings.playback.output = Устройство вывода
settings.playback.system_default = Как в системе
settings.playback.device_missing = {device} (не подключено)
settings.playback.device_current_default = {device} (сейчас по умолчанию)
settings.playback.playing_through = Звук через {device}
settings.playback.output_note = Если устройство отключено, используется системное по умолчанию; оно снова выбирается, когда устройство вернётся.
settings.playback.sleep = Таймер сна
settings.playback.sleep_custom_button = {minutes} мин (своё)
settings.playback.end_of_track = В конце трека
settings.playback.turn_off = Выключить
settings.playback.sleep_armed = Пауза: {when}
settings.playback.custom_length = Своя длительность
settings.playback.sleep_note = Также в панели плеера и на экране «Сейчас играет» (значок луны).

# ---- Equalizer
settings.eq.preset.flat = Ровный
settings.eq.preset.bass = Басы
settings.eq.preset.vocal = Вокал
settings.eq.preset.treble = Высокие
settings.eq.preset.loudness = Громкость
settings.eq.note = Применяется сразу. Усиление компенсируется, чтобы звук никогда не искажался.

# ---- Lyrics
settings.lyrics.look = Вид
settings.lyrics.animation = Анимация
settings.lyrics.animation_note = Караоке: мягкая заливка с приподнятыми словами · Apple: широкая заливка, светящееся слово · Сдвиг: резкая заливка, слова сдвигаются вверх · Свечение: ореол вокруг спетых слов · Проявление: слова плавно появляются · Нет: строка подсвечивается. Анимации слов требуют текстов с синхронизацией по словам; при синхронизации по строкам подсвечивается вся строка.
settings.lyrics.text_size = Размер текста
settings.lyrics.text_size_value = {size} пикс.
settings.lyrics.line_spacing = Межстрочный интервал
settings.lyrics.line_spacing_value = {spacing}×
settings.lyrics.alignment = Выравнивание
settings.lyrics.bg_vocals = Бэк-вокал и дуэты
settings.lyrics.bg_vocals_desc = Бэк-вокал под своей строкой; второй исполнитель — с другой стороны.
settings.lyrics.providers = Источники
settings.lyrics.providers_note = Опрашиваются в этом порядке (по несколько сразу); побеждает лучший результат. Нажмите на строку на экране «Сейчас играет», чтобы перемотать; кнопка обновления там ищет снова.
settings.lyrics.cached_only = без ключа только кешированные треки
settings.lyrics.needs_key = нужен ключ API
settings.lyrics.prefer_word = Предпочитать синхронизацию по словам
settings.lyrics.prefer_word_desc = Результат с синхронизацией по словам важнее результата по строкам от источника выше в списке.
settings.lyrics.match_duration = Сверять точную длину трека
settings.lyrics.match_duration_desc = Предпочитать тексты записи, длина которой отличается от трека не больше чем на 2 с, чтобы радиоверсия, расширенный микс или концертная запись не расходились.
settings.lyrics.waves = Опрашивать источники волнами
settings.lyrics.waves_desc = Сначала самые быстрые и надёжные источники; остальные — только если у них нет хорошего синхронного текста. Выкл.: все сразу.
settings.lyrics.reset_order = Сбросить порядок
settings.lyrics.keys_note = Ключи API сохраняются в связку ключей, когда поле теряет фокус или при нажатии Enter.
settings.lyrics.translation = Перевод
settings.lyrics.translate = Переводить тексты
settings.lyrics.translate_desc = Добавляет перевод под каждой строкой (также кнопка перевода на экране «Сейчас играет»).
settings.lyrics.translator = Переводчик
settings.lyrics.translator_ai = ИИ (совместимый с OpenAI)
settings.lyrics.language = Язык
settings.lyrics.endpoint = Адрес API
settings.lyrics.model = Модель
settings.lyrics.api_key = Ключ API
settings.lyrics.translation_note = Коды языков, например en, de, ja, zh-CN. Каждый трек переводится один раз для каждого языка и переводчика и хранится в библиотеке. У бесплатного сервиса Google есть ограничения: после отказа к нему некоторое время не обращаются (2 мин, дольше при повторных отказах), а затем повторяют перевод.
settings.lyrics.ai_missing = Укажите адрес API и модель ИИ в разделе «Настройки → Тексты песен».
settings.lyrics.romanization = Латинизация
settings.lyrics.romanization_note = Добавляет строку латиницей под строками на этих письменностях.
settings.lyrics.kanji = Чтения кандзи (японский)
settings.lyrics.kanji_embedded = Встроено в эту версию.
settings.lyrics.kanji_missing = Без него кандзи остаются как есть, а латинизируется только кана. Загружается один раз: {download} ({disk} на диске).
settings.lyrics.kanji_download = Скачать ({size})
settings.lyrics.kanji_downloading = Скачивание… {done} из {total}
settings.lyrics.kanji_ready = {name} · {size} на диске.
settings.lyrics.kanji_failed = Ошибка загрузки: {error}

# ---- Queue sections & tabs, multi-select, logs, Together suggestions, devices
settings.playback.show_all_devices = Показывать все устройства
settings.playback.show_all_devices_desc = Показывать и виртуальные и повторяющиеся выходы (в Linux: dmix, surround, hw / plughw из ALSA и подобные).
settings.playback.devices_hidden.one = Скрыто {count} виртуальное или повторяющееся устройство.
settings.playback.devices_hidden.few = Скрыто {count} виртуальных или повторяющихся устройства.
settings.playback.devices_hidden.many = Скрыто {count} виртуальных или повторяющихся устройств.
settings.playback.devices_hidden.other = Скрыто {count} виртуального или повторяющегося устройства.
