# ---- Appearance
settings.appearance.theme = Tema
settings.appearance.theme_note = O Dinâmico pega a cor de destaque da capa da faixa em reprodução (a cor vibrante mais comum, ajustada para continuar legível no fundo escuro).
settings.appearance.text_size = Tamanho do texto
settings.appearance.font_scale = {percent} %
settings.appearance.text_size_note = Ajusta todo o texto da interface; as letras mantêm o próprio tamanho (Letras).
settings.appearance.background = Fundo
settings.appearance.np_note = Gradiente, sólido e brilho pegam as cores da capa. O brilho só se move enquanto a música toca. O visual e o fundo também ficam no menu de visual da tela Tocando agora.
settings.appearance.np_fullscreen = Tela cheia ao abrir Tocando agora
settings.appearance.np_fullscreen_note = Abrir Tocando agora ou a letra coloca a janela em tela cheia, e fechar sai dela. Uma janela que já estava em tela cheia continua assim.
settings.appearance.window_group = Janela
settings.appearance.system_title_bar = Usar a barra de título do sistema
settings.appearance.system_title_bar_note = Mostra a barra de título do sistema operacional, com voltar, avançar e busca acima da página, em vez da barra superior. Vale na próxima vez que o {app} abrir.
settings.appearance.title_bar_pending = Reinicie o {app} para trocar a barra de título.
settings.appearance.mini_player = Miniplayer

# ---- Playback
settings.playback.queue = Fila
settings.playback.shuffle = Aleatório
settings.playback.shuffle_desc = Mantém a música atual em primeiro; desativar restaura a ordem.
settings.playback.repeat = Repetir
settings.playback.repeat_desc = Lembrado entre as sessões (⌘R alterna).
settings.playback.repeat_all = Todas
settings.playback.repeat_one = Uma
settings.playback.audio = Áudio
settings.playback.streams = Streams do YouTube
settings.playback.stream_auto = Músicas completas pelo caminho mais rápido que funcione: visionOS, o cliente de TV e depois os clientes com PoToken; um caminho que falha 3 vezes seguidas é ignorado por 10 min. Último recurso: uma prévia de ~1 min.
settings.playback.stream_tv = Músicas completas pelo cliente de TV (sem PoToken); uma prévia se falhar.
settings.playback.stream_visionos = Músicas completas pelo cliente visionOS (links diretos: sem PoToken nem espera); uma prévia se falhar.
settings.playback.stream_web = Músicas completas pelo cliente web e um PoToken do BotGuard (macOS / Windows); uma prévia se falhar.
settings.playback.stream_preview = Só o primeiro ~1 minuto de cada música (o comportamento antigo).
settings.playback.stream_status = Caminho do stream
settings.playback.stream_status_none = Nenhuma música transmitida ainda
settings.playback.stream_status_via = Última música via {client}
settings.playback.stream_status_preview = Última música: só prévia (todos os caminhos falharam)
settings.playback.stream_status_skipped = {clients} ignorado por {minutes} min
settings.playback.stream_status_fixes = correções do player nº {serial}
settings.playback.player_fixes = Correções do player
settings.playback.player_fixes_desc = Quando o YouTube muda algo, baixa correções assinadas (só dados, verificadas a cada 6 h) do repositório do {app} no GitHub. Desligado: só as correções incluídas nesta versão.
settings.playback.quality = Qualidade do streaming
settings.playback.quality_desc = Baixa economiza dados; Alta prefere Opus (~160 kbps) a AAC 128.
settings.playback.normalize = Normalização de volume
settings.playback.normalize_desc = Equilibra o volume com os dados de loudness do YouTube e as tags ReplayGain.
settings.playback.skip_silence = Pular silêncio
settings.playback.skip_silence_desc = Remove o silêncio nas pontas das faixas e encurta pausas longas.
settings.playback.auto_skip = Pular músicas que não carregam
settings.playback.auto_skip_desc = Segue em frente em vez de parar (até 3 seguidas).
settings.playback.transitions = Transições
settings.playback.crossfade = Crossfade
settings.playback.crossfade_value = {seconds} s
settings.playback.transitions_note = A reprodução é sem intervalos: a próxima música é carregada cerca de 30 s antes e começa já na amostra seguinte. O crossfade mistura as duas (também antes de uma prévia terminar mais cedo).
settings.playback.speed_pitch = Velocidade e tom
settings.playback.speed = Velocidade
settings.playback.speed_value = {speed}×
settings.playback.pitch = Tom
settings.playback.pitch_value = {value} st
settings.playback.speed_pitch_note = A velocidade mantém o tom; o tom mantém a velocidade.
settings.playback.output = Dispositivo de saída
settings.playback.system_default = Padrão do sistema
settings.playback.device_missing = {device} (não conectado)
settings.playback.device_current_default = {device} (padrão atual)
settings.playback.playing_through = Tocando em {device}
settings.playback.output_note = Um dispositivo ausente volta para o padrão do sistema e é usado de novo quando reaparecer.
settings.playback.sleep = Timer de suspensão
settings.playback.sleep_custom_button = {minutes} min (personalizado)
settings.playback.end_of_track = Fim da faixa
settings.playback.turn_off = Desativar
settings.playback.sleep_armed = Pausa a reprodução: {when}
settings.playback.custom_length = Duração personalizada
settings.playback.sleep_note = Também na barra do player e na tela Tocando agora (ícone de lua).

