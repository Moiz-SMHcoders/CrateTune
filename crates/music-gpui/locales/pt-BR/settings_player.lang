# ---- Lyrics
settings.lyrics.look = Visual
settings.lyrics.animation = Animação
settings.lyrics.animation_note = Karaokê: varredura suave com palavras erguidas · Apple: varredura mais ampla, palavra brilhante · Deslizar: varredura nítida, palavras sobem · Brilho: halo nas palavras cantadas · Esmaecer: as palavras aparecem aos poucos · Nenhuma: a linha se acende. As animações por palavra precisam de letras sincronizadas por palavra; letras sincronizadas por linha acendem a linha inteira.
settings.lyrics.text_size = Tamanho do texto
settings.lyrics.text_size_value = {size} px
settings.lyrics.line_spacing = Espaçamento entre linhas
settings.lyrics.line_spacing_value = {spacing}×
settings.lyrics.alignment = Alinhamento
settings.lyrics.bg_vocals = Vocais de fundo e duetos
settings.lyrics.bg_vocals_desc = Backing vocals abaixo da linha deles; um segundo cantor do outro lado.
settings.lyrics.providers = Provedores
settings.lyrics.providers_note = Consultados nesta ordem (vários ao mesmo tempo); vence o melhor resultado. Clique em uma linha no Tocando agora para ir até ela; o botão de recarregar ali pesquisa de novo.
settings.lyrics.cached_only = sem chave, só músicas em cache
settings.lyrics.needs_key = requer uma chave de API
settings.lyrics.prefer_word = Preferir letras sincronizadas por palavra
settings.lyrics.prefer_word_desc = Um resultado sincronizado por palavra vence um sincronizado por linha de um provedor mais acima.
settings.lyrics.reset_order = Redefinir ordem
settings.lyrics.keys_note = As chaves de API são salvas no chaveiro quando o campo perde o foco ou ao pressionar Enter.
settings.lyrics.translation = Tradução
settings.lyrics.translate = Traduzir letras
settings.lyrics.translate_desc = Adiciona uma linha traduzida abaixo de cada linha (também pelo botão de traduzir no Tocando agora).
settings.lyrics.translator = Tradutor
settings.lyrics.translator_ai = IA (compatível com OpenAI)
settings.lyrics.language = Idioma
settings.lyrics.endpoint = Endpoint
settings.lyrics.model = Modelo
settings.lyrics.api_key = Chave da API
settings.lyrics.translation_note = Códigos de idioma como en, de, ja, zh-CN. Cada música é traduzida uma vez por idioma e tradutor e guardada na biblioteca. O endpoint gratuito do Google tem limite de uso: depois de uma recusa, ele fica de lado por um tempo (2 min, mais se continuar recusando) e então a tradução é tentada de novo.
settings.lyrics.ai_missing = Defina o endpoint e o modelo de IA em Configurações → Letras.
settings.lyrics.romanization = Romanização
settings.lyrics.romanization_note = Adiciona uma linha em alfabeto latino abaixo das linhas nestas escritas.
settings.lyrics.kanji = Leituras de kanji (japonês)
