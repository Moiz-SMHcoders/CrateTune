# ---- Self-update (Settings → About → Updates, notifications, menu; src/update_check.rs,
# src/settings/about.rs). The older update.* keys are in settings_general.lang.

# Menu item (macOS: app menu under "About"; elsewhere: Help menu). Also a shortcut label.
menu.check_updates = Verificar atualizações…

# Buttons. {version} = a version number such as 0.2.0.
update.update_to = Atualizar para {version}
# Notification button: download and install the update that was found.
update.update_now = Atualizar
update.restart = Reiniciar para concluir
update.retry = Tentar novamente
# Opens the release page in the browser.
update.download_manually = Baixar manualmente

# Status lines.
# {progress} = update.progress, or just the amount downloaded ("12.3 MB").
update.downloading = Baixando {version}… {progress}
# {done}, {total} = sizes such as "12.3 MB".
update.progress = {done} de {total}
update.ready = A versão {version} foi baixada e verificada. Reinicie para concluir a atualização.
update.installing = Instalando {version}…

# Switches.
update.auto_check = Verificar atualizações automaticamente
update.auto_check_detail = Quando o {app} é aberto e a cada 24 horas enquanto está em execução.
update.auto_install = Instalar atualizações automaticamente
update.auto_install_detail = Baixa as atualizações em segundo plano e pede que você reinicie. Se em vez disso você encerrar o app, a atualização é instalada nesse momento.
update.prereleases = Incluir versões de pré-lançamento
update.prereleases_detail = Versões de teste publicadas antes de uma versão estável. Ativado por padrão enquanto você usa uma versão de pré-lançamento (qualquer versão 0.x).

# Notifications.
update.ready_toast = O {app} {version} está pronto. Reinicie para concluir a atualização.
# {error} = one of the update.error.* messages.
update.failed_toast = A atualização falhou. {error}

# Errors, in plain words. "Nothing was installed" = the current version is unchanged.
# {error} = an English technical detail.
update.error.network = Não foi possível acessar o GitHub ({error}). Verifique sua conexão com a internet ou o proxy.
update.error.bad_response = O GitHub enviou uma resposta inesperada ({error}).
update.error.untrusted = O link de download não aponta para as versões deste app no GitHub, por isso não foi seguido.
update.error.no_asset = Esta versão não tem um pacote para o seu sistema. Baixe-o manualmente.
update.error.no_checksums = Esta versão não tem um arquivo de somas de verificação, então o download não pode ser verificado. Nada foi instalado.
update.error.not_listed = O arquivo de somas de verificação da versão não inclui este pacote, então ele não pode ser verificado. Nada foi instalado.
update.error.mismatch = O download não corresponde à soma de verificação da versão. Ele foi excluído e nada foi instalado.
update.error.cancelled = Download cancelado.
# {path} = a folder.
update.error.not_writable = O {app} não pode se substituir porque seu usuário não tem permissão de gravação em {path}. Baixe a nova versão manualmente.
update.error.dev_build = Esta cópia não foi instalada a partir de um pacote de versão (por exemplo, foi compilada do código-fonte), então não pode se atualizar sozinha.
update.error.translocated = O macOS executa esta cópia de um local temporário somente leitura. Mova o {app} para a pasta Aplicativos, abra-o de lá e tente novamente.
update.error.system_package = Esta cópia foi instalada por um gerenciador de pacotes. Atualize-a por lá.
update.managed = As atualizações vêm do {manager}.
update.managed_detail = {app} foi instalado com o {manager}, então não se atualiza sozinho. Atualize-o por lá junto com seus outros aplicativos.
update.error.invalid = O pacote baixado não é válido ({error}). Nada foi instalado.
update.error.io = Não foi possível salvar o download ({error}).
update.error.install = A instalação falhou e a versão atual continua instalada ({error}).
