# Settings: Account, Network and About sections, the settings panel, the update
# check and the Google sign-in window.

# ---- Account
settings.account.cookie_title = Entrar com um cookie do navegador
settings.account.cookie_steps = 1. Abra music.youtube.com no navegador e entre na sua conta.\n2. Abra as ferramentas de desenvolvedor ({keys} no {browsers}) → Network (Rede) e recarregue a página.\n3. Clique em qualquer solicitação a music.youtube.com (por ex. “browse”), encontre “Cookie” em Request Headers e copie o valor inteiro.\n4. Cole abaixo. Ele fica guardado no chaveiro do sistema e só é enviado ao YouTube.
settings.account.cookie_index = Índice da conta Google (se houver várias conectadas):
settings.account.not_signed_in = Não conectado. Tudo funciona de forma anônima; ao entrar, suas músicas curtidas, álbuns salvos, inscrições e playlists são sincronizados com a biblioteca, e curtidas e edições de playlists voltam para o YouTube Music.
settings.account.sign_in_google = Entrar com o Google…
settings.account.paste_cookie = Colar cookie…
settings.account.google_refused = Se o Google recusar a janela de login (“Este navegador ou app pode não ser seguro”), use “Colar cookie”.
settings.account.profile_note = A janela de login mantém um perfil de navegador próprio para que o {app} possa renovar sua sessão em segundo plano. Sair o apaga.
settings.account.last_synced = Última sincronização: {date}
settings.account.not_synced = Ainda não sincronizado
settings.account.sync_now = Sincronizar
settings.account.syncing = Sincronizando…
settings.account.sync_group = Sincronização da biblioteca
settings.account.sync_row = Sincronizar sua biblioteca do YouTube Music
settings.account.sync_row_desc = Músicas curtidas, músicas da biblioteca, álbuns salvos, inscrições, playlists.
settings.account.auto_sync = Sincronizar com o YouTube Music automaticamente
settings.account.auto_sync_desc = Ao iniciar, a cada 45 minutos e quando você volta depois de um tempo: suas músicas curtidas, e a biblioteca inteira a cada 6 horas. Uma música que você toca também recebe o seu “Curtir” ou “Não curti” do YouTube Music.
settings.account.skip_disliked = Pular músicas que você não curtiu
settings.account.skip_disliked_desc = Marcar “Não curti” na música tocando passa para a próxima. Músicas marcadas como “Não curti” ficam fora do rádio e da reprodução automática de qualquer forma.
settings.account.accounts_group = Contas
settings.account.channels = Canais (contas de marca) desta conta Google:
settings.account.google_index = Conta Google
settings.account.google_index_desc = Seu login pode conter várias contas Google, como no youtube.com. Escolha qual o {app} usa.
settings.account.google_single = Este login tem uma única conta Google. Para usar várias, entre em cada uma no music.youtube.com em um navegador, depois saia aqui e cole o cookie desse navegador.
settings.account.cookie_note = O login usa o cookie de sessão do navegador para music.youtube.com. Ele fica guardado no chaveiro do sistema e só é enviado ao YouTube. Os recursos de conta foram feitos com base na API web do YouTube, mas ainda não foram verificados com uma conta real.

