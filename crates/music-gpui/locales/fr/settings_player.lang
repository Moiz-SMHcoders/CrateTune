# ---- Appearance
settings.appearance.theme = Thème
settings.appearance.theme_note = Dynamique reprend la couleur d'accent de la pochette du titre en cours (la couleur vive la plus fréquente, ajustée pour rester lisible sur le fond sombre).
settings.appearance.text_size = Taille du texte
settings.appearance.font_scale = {percent} %
settings.appearance.text_size_note = Met à l'échelle tout le texte de l'interface ; les paroles gardent leur propre taille (Paroles).
settings.appearance.background = Arrière-plan
settings.appearance.np_note = Dégradé, couleur unie et halo reprennent les couleurs de la pochette. Le halo ne bouge que pendant la lecture. La disposition et l'arrière-plan se règlent aussi dans le menu de disposition de l'écran À l'écoute.
settings.appearance.np_fullscreen = Plein écran à l'ouverture d'À l'écoute
settings.appearance.np_fullscreen_note = Ouvrir l'écran À l'écoute ou les paroles passe la fenêtre en plein écran, et les fermer en sort. Une fenêtre déjà en plein écran le reste.
settings.appearance.window_group = Fenêtre
settings.appearance.system_title_bar = Utiliser la barre de titre du système
settings.appearance.system_title_bar_note = Affiche la barre de titre du système, avec précédent, suivant et recherche au-dessus de la page, au lieu de la barre du haut. Prend effet au prochain lancement de {app}.
settings.appearance.title_bar_pending = Redémarrez {app} pour changer de barre de titre.
settings.appearance.mini_player = Mini-lecteur

# ---- Playback
settings.playback.queue = File d'attente
settings.playback.shuffle = Aléatoire
settings.playback.shuffle_desc = Garde le titre en cours en premier ; le désactiver rétablit l'ordre.
settings.playback.repeat = Répéter
settings.playback.repeat_desc = Mémorisé entre les lancements (⌘R pour changer de mode).
settings.playback.repeat_all = Tout
settings.playback.repeat_one = Un
settings.playback.audio = Audio
settings.playback.streams = Flux YouTube
settings.playback.stream_auto = Titres complets par la méthode la plus rapide qui fonctionne : visionOS, le client TV, puis les clients avec PoToken ; une méthode qui échoue 3 fois de suite est ignorée 10 min. En dernier recours : un extrait d'environ 1 min.
settings.playback.stream_tv = Titres complets via le client TV (sans PoToken) ; un extrait en cas d'échec.
settings.playback.stream_visionos = Titres complets via le client visionOS (liens directs : sans PoToken ni attente) ; un extrait en cas d'échec.
settings.playback.stream_web = Titres complets via le client web et un PoToken BotGuard (macOS / Windows) ; un extrait en cas d'échec.
settings.playback.stream_preview = Seulement la première minute environ de chaque titre (l'ancien comportement).
settings.playback.stream_status = Méthode utilisée
settings.playback.stream_status_none = Aucun titre diffusé pour l'instant
settings.playback.stream_status_via = Dernier titre via {client}
settings.playback.stream_status_preview = Dernier titre : extrait seulement (toutes les méthodes ont échoué)
settings.playback.stream_status_skipped = {clients} ignoré pendant {minutes} min
settings.playback.stream_status_fixes = correctifs du lecteur n° {serial}
settings.playback.player_fixes = Correctifs du lecteur
settings.playback.player_fixes_desc = Quand YouTube change quelque chose, télécharger des correctifs signés (données uniquement, vérifiés toutes les 6 h) depuis le dépôt GitHub de {app}. Désactivé : uniquement les correctifs inclus dans cette version.
settings.playback.quality = Qualité du streaming
settings.playback.quality_desc = Basse économise les données ; Haute préfère Opus (~160 kbit/s) à AAC 128.
settings.playback.normalize = Normalisation du volume
settings.playback.normalize_desc = Égalise le volume grâce aux données de sonie de YouTube et aux balises ReplayGain.
settings.playback.skip_silence = Ignorer les silences
settings.playback.skip_silence_desc = Supprime les silences en début et fin de titre et raccourcit les longs passages silencieux.
settings.playback.auto_skip = Ignorer les titres qui ne se chargent pas
settings.playback.auto_skip_desc = Passe au suivant au lieu de s'arrêter (jusqu'à 3 d'affilée).
settings.playback.transitions = Transitions
settings.playback.crossfade = Fondu enchaîné
settings.playback.crossfade_value = {seconds} s
settings.playback.transitions_note = La lecture est sans blanc : le titre suivant est préchargé environ 30 s à l'avance et démarre dès l'échantillon suivant. Le fondu enchaîné mélange les deux (aussi avant la fin anticipée d'un extrait).
settings.playback.speed_pitch = Vitesse et tonalité
settings.playback.speed = Vitesse
settings.playback.speed_value = {speed}×
settings.playback.pitch = Tonalité
settings.playback.pitch_value = {value} demi-tons
settings.playback.speed_pitch_note = La vitesse conserve la tonalité ; la tonalité conserve la vitesse.
settings.playback.output = Périphérique de sortie
settings.playback.system_default = Par défaut du système
settings.playback.device_missing = {device} (non connecté)
settings.playback.device_current_default = {device} (par défaut actuellement)
settings.playback.playing_through = Lecture via {device}
settings.playback.output_note = Si un périphérique est absent, la sortie par défaut du système est utilisée, puis il est repris dès son retour.
settings.playback.sleep = Minuteur de veille
settings.playback.sleep_custom_button = {minutes} min (personnalisé)
settings.playback.end_of_track = Fin du titre
settings.playback.turn_off = Désactiver
settings.playback.sleep_armed = Met la lecture en pause : {when}
settings.playback.custom_length = Durée personnalisée
settings.playback.sleep_note = Également dans la barre de lecture et sur l'écran À l'écoute (icône lune).

# ---- Equalizer
settings.eq.preset.flat = Plat
settings.eq.preset.bass = Basses
settings.eq.preset.vocal = Voix
settings.eq.preset.treble = Aigus
settings.eq.preset.loudness = Loudness
settings.eq.note = Appliqué en direct. Les amplifications sont compensées pour que la sortie ne sature jamais.

# ---- Lyrics
settings.lyrics.look = Apparence
settings.lyrics.animation = Animation
settings.lyrics.animation_note = Karaoké : balayage doux avec mots soulevés · Apple : balayage plus large, mot lumineux · Glissement : balayage net, les mots glissent vers le haut · Halo : halo autour des mots chantés · Fondu : les mots apparaissent en fondu · Aucune : la ligne s'illumine. Les animations par mot nécessitent des paroles synchronisées par mot ; avec des paroles synchronisées par ligne, toute la ligne s'illumine.
settings.lyrics.text_size = Taille du texte
settings.lyrics.text_size_value = {size} px
settings.lyrics.line_spacing = Interligne
settings.lyrics.line_spacing_value = {spacing}×
settings.lyrics.alignment = Alignement
settings.lyrics.bg_vocals = Chœurs et duos
settings.lyrics.bg_vocals_desc = Les chœurs sous leur ligne ; un second chanteur de l'autre côté.
settings.lyrics.providers = Fournisseurs
settings.lyrics.providers_note = Interrogés dans cet ordre (plusieurs à la fois) ; le meilleur résultat l'emporte. Cliquez sur une ligne dans À l'écoute pour vous y rendre ; le bouton d'actualisation relance la recherche.
settings.lyrics.cached_only = titres en cache uniquement sans clé
settings.lyrics.needs_key = nécessite une clé API
settings.lyrics.prefer_word = Préférer les paroles synchronisées par mot
settings.lyrics.prefer_word_desc = Un résultat synchronisé par mot l'emporte sur un résultat synchronisé par ligne d'un fournisseur placé plus haut.
settings.lyrics.match_duration = Faire correspondre la durée exacte
settings.lyrics.match_duration_desc = Préférer les paroles d'un enregistrement à moins de 2 s du titre, pour qu'une version radio, longue ou live ne se décale pas.
settings.lyrics.waves = Interroger les sources par vagues
settings.lyrics.waves_desc = D'abord les sources les plus rapides et fiables ; les autres seulement sans bonnes paroles synchronisées. Désactivé : toutes en même temps.
settings.lyrics.reset_order = Réinitialiser l'ordre
settings.lyrics.keys_note = Les clés API sont enregistrées dans le trousseau quand le champ perd le focus ou avec Entrée.
settings.lyrics.translation = Traduction
settings.lyrics.translate = Traduire les paroles
settings.lyrics.translate_desc = Ajoute une ligne traduite sous chaque ligne (aussi via le bouton de traduction dans À l'écoute).
settings.lyrics.translator = Traducteur
settings.lyrics.translator_ai = IA (compatible OpenAI)
settings.lyrics.language = Langue
settings.lyrics.endpoint = Point d'accès
settings.lyrics.model = Modèle
settings.lyrics.api_key = Clé API
settings.lyrics.translation_note = Codes de langue comme en, de, ja, zh-CN. Chaque titre est traduit une fois par langue et par traducteur, puis conservé dans la bibliothèque. Le point d'accès gratuit de Google est limité en débit : après un refus, il est laissé de côté un moment (2 min, plus s'il continue de refuser) puis la traduction est retentée.
settings.lyrics.ai_missing = Définissez le point d'accès et le modèle d'IA dans Paramètres → Paroles.
settings.lyrics.romanization = Romanisation
settings.lyrics.romanization_note = Ajoute une ligne en alphabet latin sous les lignes écrites dans ces systèmes d'écriture.
settings.lyrics.kanji = Lectures des kanji (japonais)
settings.lyrics.kanji_embedded = Intégré à cette version.
settings.lyrics.kanji_missing = Sans cela, les kanji restent tels quels et seuls les kana sont romanisés. Télécharge {download} une fois ({disk} sur le disque).
settings.lyrics.kanji_download = Télécharger ({size})
settings.lyrics.kanji_downloading = Téléchargement… {done} sur {total}
settings.lyrics.kanji_ready = {name} · {size} sur le disque.
settings.lyrics.kanji_failed = Échec du téléchargement : {error}

