# Friend groups (see locales/en/friends.lang).

# The Settings section's name.
settings.section.friends = Amigos

# ---- Settings → Friends
settings.friends.title = Grupos de amigos
settings.friends.intro = Ten un grupo fijo de amigos en lugar de una sala nueva de Music Together cada vez: mira lo que están escuchando e inicia una sesión para todo el grupo con un clic.
settings.friends.enabled = Usar grupos de amigos
settings.friends.enabled_desc = Desactivado por defecto. Tu equipo se comunica entonces directamente con los equipos de tus amigos, con cifrado de extremo a extremo.
settings.friends.privacy = Lo que ven tus amigos: tu nombre y, solo mientras compartes, la canción que reproduces (título, artista, su id de YouTube y cuándo empezó). Nada se guarda en un servidor: el relay solo transmite datos cifrados y ve tu dirección IP. Los grupos se guardan en el equipo de cada miembro.

settings.friends.you = Tú
settings.friends.name = Nombre
settings.friends.name_note = Cómo te ven tus amigos.
settings.friends.share = Compartir lo que escucho
settings.friends.share_desc = Tus amigos ven en su feed la canción que reproduces. Las canciones de tus propios archivos nunca se comparten.
settings.friends.private = Sesión privada
settings.friends.private_desc = Pausa el uso compartido hasta que cierres la app.
settings.friends.member_id = Id de miembro: {id}

settings.friends.groups = Tus grupos
settings.friends.no_groups = Aún no hay grupos. Crea uno e invita a tus amigos, o únete a uno con el código que te muestre un amigo.
