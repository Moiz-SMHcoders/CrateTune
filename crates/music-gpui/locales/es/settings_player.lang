# ---- Appearance
settings.appearance.theme = Tema
settings.appearance.theme_note = Dinámico toma su acento de la portada de la canción que suena (el color vivo más frecuente, ajustado para que se lea bien sobre el fondo oscuro).
settings.appearance.text_size = Tamaño del texto
settings.appearance.font_scale = {percent} %
settings.appearance.text_size_note = Escala todo el texto de la interfaz; las letras tienen su propio tamaño (Letras).
settings.appearance.background = Fondo
settings.appearance.np_note = Degradado, sólido y brillo toman sus colores de la portada. El brillo solo se mueve mientras suena música. El diseño y el fondo también están en el menú de diseño de la pantalla Reproduciendo.
settings.appearance.np_fullscreen = Pantalla completa al abrir Reproduciendo
settings.appearance.np_fullscreen_note = Al abrir Reproduciendo o la letra, la ventana pasa a pantalla completa, y al cerrarlos sale de ella. Si la ventana ya estaba en pantalla completa, se queda así.
settings.appearance.window_group = Ventana
settings.appearance.system_title_bar = Usar la barra de título del sistema
settings.appearance.system_title_bar_note = Muestra la barra de título del sistema operativo, con atrás, adelante y búsqueda sobre la página, en lugar de la barra superior. Se aplica la próxima vez que se inicie {app}.
settings.appearance.title_bar_pending = Reinicia {app} para cambiar la barra de título.
settings.appearance.mini_player = Minirreproductor

# ---- Playback
settings.playback.queue = Cola
settings.playback.shuffle = Aleatorio
settings.playback.shuffle_desc = Mantiene la canción actual en primer lugar; al desactivarlo se restaura el orden.
settings.playback.repeat = Repetir
settings.playback.repeat_desc = Se recuerda entre sesiones (⌘R lo alterna).
settings.playback.repeat_all = Todo
settings.playback.repeat_one = Una
settings.playback.audio = Audio
settings.playback.streams = Transmisiones de YouTube
settings.playback.stream_auto = Canciones completas por la vía más rápida que funcione: visionOS, el cliente de TV y luego los clientes con PoToken; una vía que falla 3 veces seguidas se omite 10 min. Último recurso: un avance de ~1 min.
settings.playback.stream_tv = Canciones completas mediante el cliente de TV (sin PoToken); un avance si falla.
settings.playback.stream_visionos = Canciones completas mediante el cliente de visionOS (enlaces directos: sin PoToken ni espera); un avance si falla.
settings.playback.stream_web = Canciones completas mediante el cliente web y un PoToken de BotGuard (macOS / Windows); un avance si falla.
settings.playback.stream_preview = Solo el primer ~1 minuto de cada canción (el comportamiento anterior).
settings.playback.stream_status = Vía de transmisión
settings.playback.stream_status_none = Aún no se ha transmitido ninguna canción
settings.playback.stream_status_via = Última canción vía {client}
settings.playback.stream_status_preview = Última canción: solo avance (fallaron todas las vías)
settings.playback.stream_status_skipped = {clients} omitido durante {minutes} min
settings.playback.stream_status_fixes = correcciones del reproductor n.º {serial}
settings.playback.player_fixes = Correcciones del reproductor
settings.playback.player_fixes_desc = Cuando YouTube cambia algo, descarga correcciones firmadas (solo datos, revisadas cada 6 h) del repositorio de GitHub de {app}. Desactivado: solo las correcciones incluidas en esta versión.
settings.playback.quality = Calidad de transmisión
settings.playback.quality_desc = Baja ahorra datos; Alta prefiere Opus (~160 kbps) a AAC 128.
settings.playback.normalize = Normalización del volumen
settings.playback.normalize_desc = Iguala el volumen con los datos de sonoridad de YouTube y las etiquetas ReplayGain.
settings.playback.skip_silence = Omitir silencios
settings.playback.skip_silence_desc = Quita el silencio al principio y al final de las canciones y acorta las pausas largas.
settings.playback.auto_skip = Omitir canciones que fallan
settings.playback.auto_skip_desc = Pasa a la siguiente en lugar de detenerse (hasta 3 seguidas).
settings.playback.transitions = Transiciones
settings.playback.crossfade = Fundido cruzado
settings.playback.crossfade_value = {seconds} s
settings.playback.transitions_note = La reproducción es continua: la siguiente canción se precarga unos 30 s antes y empieza justo en la muestra siguiente. El fundido cruzado mezcla las dos (también antes de que un avance termine antes de tiempo).
settings.playback.speed_pitch = Velocidad y tono
settings.playback.speed = Velocidad
settings.playback.speed_value = {speed}×
settings.playback.pitch = Tono
settings.playback.pitch_value = {value} st
settings.playback.speed_pitch_note = La velocidad mantiene el tono; el tono mantiene la velocidad.
settings.playback.output = Dispositivo de salida
settings.playback.system_default = Predeterminado del sistema
settings.playback.device_missing = {device} (no conectado)
settings.playback.device_current_default = {device} (predeterminado actual)
settings.playback.playing_through = Reproduciendo en {device}
settings.playback.output_note = Si falta un dispositivo, se usa el predeterminado del sistema, y se vuelve a usar cuando reaparece.
settings.playback.sleep = Temporizador
settings.playback.sleep_custom_button = {minutes} min (personalizado)
settings.playback.end_of_track = Fin de la canción
settings.playback.turn_off = Desactivar
settings.playback.sleep_armed = Pausa la reproducción: {when}
settings.playback.custom_length = Duración personalizada
settings.playback.sleep_note = También en la barra del reproductor y en la pantalla Reproduciendo (icono de luna).

