# ---- Lyrics
settings.lyrics.look = Aspecto
settings.lyrics.animation = Animación
settings.lyrics.animation_note = Karaoke: barrido suave con palabras elevadas · Apple: barrido más amplio, palabra brillante · Deslizar: barrido nítido, las palabras suben · Brillo: halo alrededor de las palabras cantadas · Fundido: las palabras aparecen gradualmente · Ninguna: la línea se ilumina. Las animaciones por palabra necesitan letras sincronizadas por palabra; las letras sincronizadas por línea iluminan la línea entera.
settings.lyrics.text_size = Tamaño del texto
settings.lyrics.text_size_value = {size} px
settings.lyrics.line_spacing = Interlineado
settings.lyrics.line_spacing_value = {spacing}×
settings.lyrics.alignment = Alineación
settings.lyrics.bg_vocals = Coros y dúos
settings.lyrics.bg_vocals_desc = Los coros, debajo de su línea; un segundo cantante, en el otro lado.
settings.lyrics.providers = Proveedores
settings.lyrics.providers_note = Se consultan en este orden (varios a la vez); gana el mejor resultado. Haz clic en una línea en Reproduciendo para ir a ese punto; el botón de recarga vuelve a buscar.
settings.lyrics.cached_only = sin clave, solo canciones en caché
settings.lyrics.needs_key = necesita una clave de API
settings.lyrics.prefer_word = Preferir letras sincronizadas por palabra
settings.lyrics.prefer_word_desc = Un resultado sincronizado por palabra gana a uno sincronizado por línea de un proveedor situado más arriba.
settings.lyrics.reset_order = Restablecer orden
settings.lyrics.keys_note = Las claves de API se guardan en el llavero cuando el campo pierde el foco o al pulsar Enter.
settings.lyrics.translation = Traducción
settings.lyrics.translate = Traducir letras
settings.lyrics.translate_desc = Añade una línea traducida debajo de cada línea (también con el botón de traducir en Reproduciendo).
settings.lyrics.translator = Traductor
settings.lyrics.translator_ai = IA (compatible con OpenAI)
settings.lyrics.language = Idioma
settings.lyrics.endpoint = Endpoint
settings.lyrics.model = Modelo
settings.lyrics.api_key = Clave de API
settings.lyrics.translation_note = Códigos de idioma como en, de, ja, zh-CN. Cada canción se traduce una vez por idioma y traductor, y se guarda en la biblioteca. El endpoint gratuito de Google tiene un límite de solicitudes: tras un rechazo, se deja de usar un tiempo (2 min, más si sigue rechazando) y luego se vuelve a intentar la traducción.
settings.lyrics.ai_missing = Configura el endpoint y el modelo de IA en Configuración → Letras.
settings.lyrics.romanization = Romanización
settings.lyrics.romanization_note = Añade una línea en alfabeto latino debajo de las líneas en estas escrituras.
settings.lyrics.kanji = Lecturas de kanji (japonés)
settings.lyrics.kanji_embedded = Incluido en esta versión.
settings.lyrics.kanji_missing = Sin él, los kanji se quedan como están y solo se romanizan los kana. Descarga {download} una vez ({disk} en disco).
settings.lyrics.kanji_download = Descargar ({size})
settings.lyrics.kanji_downloading = Descargando… {done} de {total}
settings.lyrics.kanji_ready = {name} · {size} en disco.
settings.lyrics.kanji_failed = Error en la descarga: {error}
