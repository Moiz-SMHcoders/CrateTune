settings.playback.custom_length = Własny czas
settings.playback.sleep_note = Dostępny także na pasku odtwarzacza i na ekranie Teraz odtwarzane (ikona księżyca).

# ---- Equalizer
settings.eq.preset.flat = Płaski
settings.eq.preset.bass = Basy
settings.eq.preset.vocal = Wokal
settings.eq.preset.treble = Soprany
settings.eq.preset.loudness = Głośność
