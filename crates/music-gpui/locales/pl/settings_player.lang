# ---- Appearance
settings.appearance.theme = Motyw
settings.appearance.theme_note = Motyw dynamiczny bierze kolor akcentu z okładki odtwarzanego utworu (najczęstszy żywy kolor, dostosowany tak, aby był czytelny na ciemnym tle).
settings.appearance.text_size = Rozmiar tekstu
settings.appearance.font_scale = {percent}%
settings.appearance.text_size_note = Skaluje cały tekst interfejsu; teksty piosenek mają własny rozmiar (Teksty).
settings.appearance.background = Tło
settings.appearance.np_note = Gradient, jednolity kolor i poświata biorą kolory z okładki. Poświata porusza się tylko podczas odtwarzania. Układ i tło są też dostępne w menu ekranu Teraz odtwarzane.
settings.appearance.np_fullscreen = Pełny ekran po otwarciu Teraz odtwarzane
settings.appearance.np_fullscreen_note = Otwarcie ekranu Teraz odtwarzane lub tekstu przełącza okno na pełny ekran, a zamknięcie z niego wychodzi. Okno, które już było na pełnym ekranie, takie pozostaje.
settings.appearance.window_group = Okno
settings.appearance.system_title_bar = Używaj systemowego paska tytułu
settings.appearance.system_title_bar_note = Pokazuje pasek tytułu systemu, z przyciskami wstecz, dalej i wyszukiwaniem nad stroną, zamiast górnego paska. Działa od następnego uruchomienia {app}.
settings.appearance.title_bar_pending = Uruchom {app} ponownie, aby zmienić pasek tytułu.
settings.appearance.mini_player = Miniodtwarzacz

# ---- Playback
settings.playback.queue = Kolejka
settings.playback.shuffle = Odtwarzanie losowe
settings.playback.shuffle_desc = Bieżący utwór pozostaje pierwszy; wyłączenie przywraca kolejność.
settings.playback.repeat = Powtarzanie
settings.playback.repeat_desc = Zapamiętywane między uruchomieniami (⌘R przełącza tryb).
settings.playback.repeat_all = Wszystkie
settings.playback.repeat_one = Jeden
settings.playback.audio = Dźwięk
settings.playback.streams = Strumienie YouTube
settings.playback.stream_auto = Pełne utwory najszybszym działającym sposobem: visionOS, klient TV, potem klienci z PoToken; sposób, który zawiedzie 3 razy z rzędu, jest pomijany przez 10 min. Ostatnia deska ratunku: podgląd ~1 min.
settings.playback.stream_tv = Pełne utwory przez klienta TV (bez PoToken); w razie błędu podgląd.
settings.playback.stream_visionos = Pełne utwory przez klienta visionOS (bezpośrednie linki: bez PoToken i czekania); w razie błędu podgląd.
settings.playback.stream_web = Pełne utwory przez klienta web i PoToken BotGuard (macOS / Windows); w razie błędu podgląd.
settings.playback.stream_preview = Tylko pierwsza ~1 minuta każdego utworu (dawne zachowanie).
settings.playback.stream_status = Sposób strumieniowania
settings.playback.stream_status_none = Jeszcze nic nie odtworzono
settings.playback.stream_status_via = Ostatni utwór przez {client}
settings.playback.stream_status_preview = Ostatni utwór: tylko podgląd (wszystkie sposoby zawiodły)
settings.playback.stream_status_skipped = {clients} pomijany przez {minutes} min
settings.playback.stream_status_fixes = poprawki odtwarzacza nr {serial}
settings.playback.player_fixes = Poprawki odtwarzacza
settings.playback.player_fixes_desc = Gdy YouTube coś zmieni, pobieraj podpisane poprawki (tylko dane, sprawdzane co 6 godz.) z repozytorium GitHub aplikacji {app}. Wyłączone: tylko poprawki wbudowane w tę wersję.
settings.playback.quality = Jakość strumienia
settings.playback.quality_desc = Niska oszczędza dane; Wysoka preferuje Opus (~160 kb/s) zamiast AAC 128.
settings.playback.normalize = Normalizacja głośności
settings.playback.normalize_desc = Wyrównuje głośność na podstawie danych YouTube i tagów ReplayGain.
settings.playback.skip_silence = Pomijaj ciszę
settings.playback.skip_silence_desc = Usuwa ciszę na początku i końcu utworu i skraca długie przerwy.
settings.playback.auto_skip = Pomijaj utwory, których nie da się wczytać
settings.playback.auto_skip_desc = Przechodzi dalej zamiast się zatrzymywać (do 3 z rzędu).
settings.playback.transitions = Przejścia
settings.playback.crossfade = Przenikanie
settings.playback.crossfade_value = {seconds} s
settings.playback.transitions_note = Odtwarzanie jest bez przerw: następny utwór jest buforowany około 30 s wcześniej i zaczyna się od razu od następnej próbki. Przenikanie łączy oba utwory (także przed wcześniejszym końcem podglądu).
settings.playback.speed_pitch = Szybkość i wysokość dźwięku
settings.playback.speed = Szybkość
settings.playback.speed_value = {speed}×
settings.playback.pitch = Wysokość
