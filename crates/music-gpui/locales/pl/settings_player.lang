# ---- Lyrics
settings.lyrics.look = Wygląd
settings.lyrics.animation = Animacja
settings.lyrics.animation_note = Karaoke: miękkie wypełnienie z uniesionymi słowami · Apple: szersze wypełnienie, świecące słowo · Przesunięcie: ostre wypełnienie, słowa przesuwają się w górę · Poświata: blask wokół zaśpiewanych słów · Zanikanie: słowa płynnie się pojawiają · Brak: wiersz się podświetla. Animacje słów wymagają tekstów synchronizowanych co do słowa; przy synchronizacji wierszy podświetla się cały wiersz.
settings.lyrics.text_size = Rozmiar tekstu
settings.lyrics.text_size_value = {size} px
settings.lyrics.line_spacing = Odstęp między wierszami
settings.lyrics.line_spacing_value = {spacing}×
settings.lyrics.alignment = Wyrównanie
settings.lyrics.bg_vocals = Chórki i duety
settings.lyrics.bg_vocals_desc = Chórki pod swoim wierszem; drugi wokalista po drugiej stronie.
settings.lyrics.providers = Dostawcy
settings.lyrics.providers_note = Odpytywani w tej kolejności (po kilku naraz); wygrywa najlepszy wynik. Kliknij wiersz na ekranie Teraz odtwarzane, aby przewinąć; przycisk odświeżania szuka ponownie.
settings.lyrics.cached_only = bez klucza tylko zapisane utwory
settings.lyrics.needs_key = wymaga klucza API
settings.lyrics.prefer_word = Preferuj synchronizację słów
settings.lyrics.prefer_word_desc = Wynik synchronizowany co do słowa wygrywa z synchronizowanym co do wiersza od dostawcy wyżej na liście.
settings.lyrics.reset_order = Przywróć kolejność
settings.lyrics.keys_note = Klucze API są zapisywane w pęku kluczy, gdy pole traci fokus lub po naciśnięciu Enter.
settings.lyrics.translation = Tłumaczenie
settings.lyrics.translate = Tłumacz teksty
settings.lyrics.translate_desc = Dodaje przetłumaczony wiersz pod każdym wierszem (także przycisk tłumaczenia na ekranie Teraz odtwarzane).
settings.lyrics.translator = Tłumacz
settings.lyrics.translator_ai = AI (zgodne z OpenAI)
settings.lyrics.language = Język
settings.lyrics.endpoint = Endpoint
settings.lyrics.model = Model
settings.lyrics.api_key = Klucz API
settings.lyrics.translation_note = Kody języków, np. en, de, ja, zh-CN. Każdy utwór jest tłumaczony raz na język i tłumacza i przechowywany w bibliotece. Darmowy endpoint Google ma limity: po odmowie jest przez jakiś czas pomijany (2 min, dłużej przy kolejnych odmowach), a potem tłumaczenie jest ponawiane.
settings.lyrics.ai_missing = Ustaw endpoint i model AI w Ustawienia → Teksty.
settings.lyrics.romanization = Latynizacja
settings.lyrics.romanization_note = Dodaje wiersz w alfabecie łacińskim pod wierszami w tych pismach.
settings.lyrics.kanji = Odczyty kanji (japoński)
settings.lyrics.kanji_embedded = Wbudowane w tę wersję.
settings.lyrics.kanji_missing = Bez niego kanji pozostają bez zmian i latynizowane są tylko kana. Pobiera {download} jednorazowo ({disk} na dysku).
