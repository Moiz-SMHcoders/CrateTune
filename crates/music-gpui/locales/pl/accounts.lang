account.toast.removed = Usunięto {name}
account.toast.signed_out_switched = Wylogowano. Teraz używane: {name}
account.list.no_saved_cookie = Nie udało się odczytać zapisanego logowania konta {name}. Zaloguj się do niego ponownie.
titlebar.add_account = Dodaj konto…
settings.account.from_browser = Zaloguj się przez przeglądarkę…
settings.account.browser_note = „Zaloguj się przez przeglądarkę” przejmuje logowanie do YouTube z przeglądarki na tym komputerze (Chrome, Edge, Brave, Firefox, Safari, Arc, Vivaldi, Opera, Chromium), więc nie musisz logować się ponownie.
settings.account.in_use = W użyciu
settings.account.switch = Przełącz
settings.account.remove = Usuń to konto
settings.account.list_group = Twoje konta
settings.account.add = Dodaj konto
settings.account.add_desc = Zaloguj się do kolejnego konta YouTube Music; przełączaj się tutaj lub w menu konta na pasku tytułu.
settings.account.list_note = Polubione utwory, zapisane albumy, subskrypcje i playlisty YouTube należą do konta w użyciu i są ponownie synchronizowane po przełączeniu. Pliki lokalne, lokalne playlisty, historia odtwarzania i pobrane pliki są wspólne dla wszystkich kont.
settings.account.report_plays = Dodawaj odtworzenia do mojej historii YouTube
settings.account.report_plays_desc = To, czego słuchasz tutaj, pojawia się w historii YouTube Music na innych urządzeniach i poprawia rekomendacje. Nic nie jest wysyłane, gdy historia słuchania jest wstrzymana.
browser_import.title = Zaloguj się przez przeglądarkę
browser_import.intro = Wybierz profil przeglądarki, w którym jesteś zalogowany do music.youtube.com. {app} odczytuje tylko jego ciasteczka youtube.com, na tym komputerze, i przechowuje je w pęku kluczy jak każde logowanie.
browser_import.note.keychain = macOS zapyta, czy {app} może użyć „<browser> Safe Storage” z pęku kluczy. To normalne: to klucz do ciasteczek przeglądarki. Wybierz Pozwól.
browser_import.note.app_bound = W nowszych wersjach Windows Chrome, Edge i Brave blokują swoje ciasteczka dla innych aplikacji (szyfrowanie powiązane z aplikacją). Te profile są widoczne, ale nie da się ich odczytać; użyj Firefoksa, „Zaloguj się przez Google…” lub wklejonego ciasteczka.
browser_import.none_found = Na tym komputerze nie znaleziono obsługiwanej przeglądarki z zapisanymi ciasteczkami.
browser_import.import = Importuj
browser_import.last_used = Ostatnio używany {date}
browser_import.blocked.app_bound = Zablokowane przez przeglądarkę (szyfrowanie powiązane z aplikacją)
browser_import.blocked.no_key = Nie znaleziono klucza ciasteczek przeglądarki
browser_import.blocked.full_disk_access = Wymaga pełnego dostępu do dysku (Ustawienia systemowe → Prywatność i ochrona)
browser_import.reading = Odczytywanie logowania do YouTube z {browser}…
browser_import.error.not_found = Magazyn ciasteczek przeglądarki {browser} już nie istnieje.
browser_import.error.locked = {browser} blokuje swoje ciasteczka, gdy działa. Zamknij {browser} i spróbuj ponownie.
browser_import.error.full_disk_access = {app} potrzebuje pełnego dostępu do dysku, aby odczytać ciasteczka Safari: Ustawienia systemowe → Prywatność i ochrona → Pełny dostęp do dysku.
browser_import.error.permission = {app} nie ma uprawnień do odczytu ciasteczek przeglądarki {browser}.
browser_import.error.keychain = macOS nie udostępnił „{browser} Safe Storage”, klucza do ciasteczek przeglądarki {browser}. Spróbuj ponownie i wybierz Pozwól, gdy macOS zapyta.
browser_import.error.no_key = Nie znaleziono klucza do ciasteczek przeglądarki {browser}.
browser_import.error.app_bound = {browser} w tej wersji Windows blokuje swoje ciasteczka dla innych aplikacji (szyfrowanie powiązane z aplikacją), więc nikt inny ich nie odczyta. Użyj Firefoksa, „Zaloguj się przez Google…” lub wklejonego ciasteczka.
browser_import.error.decrypt = Nie udało się odszyfrować ciasteczek przeglądarki {browser}.
browser_import.error.not_signed_in = {browser} ({profile}) nie jest zalogowany do YouTube. Najpierw zaloguj się tam do music.youtube.com.
browser_import.error.format = Nie udało się odczytać magazynu ciasteczek przeglądarki {browser}.
