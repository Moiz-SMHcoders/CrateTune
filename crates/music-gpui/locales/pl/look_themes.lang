settings.app_icon = Ikona aplikacji
settings.app_icon_note = Widoczna w Docku i przełączniku aplikacji (macOS) lub na oknie i pasku zadań (Windows, Linux z X11).
settings.app_icon.linux_note = W Linuksie działa od następnego uruchomienia (X11); pulpity Wayland pokazują zainstalowaną ikonę.
settings.app_icon.choose = Wybierz obraz…
app_icon.custom = Twój obraz
app_icon.default = Północ
app_icon.light = Papier
app_icon.sunset = Zachód słońca
app_icon.mint = Mięta
