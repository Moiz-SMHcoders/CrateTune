# Settings: Account, Network, About, update check, sign-in window (Polish).

# ---- Account
settings.account.cookie_title = Zaloguj się plikiem cookie przeglądarki
settings.account.cookie_steps = 1. Otwórz music.youtube.com w przeglądarce i zaloguj się.\n2. Otwórz narzędzia deweloperskie ({keys} w {browsers}) → Network (Sieć) i odśwież stronę.\n3. Kliknij dowolne żądanie do music.youtube.com (np. “browse”), znajdź “Cookie” w sekcji Request Headers i skopiuj całą wartość.\n4. Wklej ją poniżej. Jest przechowywana w pęku kluczy systemu i wysyłana tylko do YouTube.
settings.account.cookie_index = Numer konta Google (jeśli zalogowano kilka):
settings.account.not_signed_in = Nie zalogowano. Wszystko działa anonimowo; po zalogowaniu polubione utwory, zapisane albumy, subskrypcje i playlisty synchronizują się z biblioteką, a polubienia i zmiany playlist trafiają z powrotem do YouTube Music.
settings.account.sign_in_google = Zaloguj się przez Google…
settings.account.paste_cookie = Wklej cookie…
settings.account.google_refused = Jeśli Google odrzuca okno logowania („Ta przeglądarka lub aplikacja może nie być bezpieczna”), użyj „Wklej cookie”.
settings.account.profile_note = Okno logowania ma własny profil przeglądarki, dzięki czemu {app} może odnawiać sesję w tle. Wylogowanie go usuwa.
settings.account.last_synced = Ostatnia synchronizacja: {date}
settings.account.not_synced = Jeszcze nie zsynchronizowano
settings.account.sync_now = Synchronizuj
settings.account.syncing = Synchronizowanie…
settings.account.sync_group = Synchronizacja biblioteki
settings.account.sync_row = Synchronizuj bibliotekę YouTube Music
settings.account.sync_row_desc = Polubione utwory, utwory z biblioteki, zapisane albumy, subskrypcje, playlisty.
settings.account.auto_sync = Automatycznie synchronizuj z YouTube Music
settings.account.auto_sync_desc = Przy starcie, co 45 minut i po powrocie po dłuższej chwili: polubione utwory, a co 6 godzin cała biblioteka. Odtwarzany utwór przejmuje też swoje „Lubię to” lub „Nie lubię” z YouTube Music.
settings.account.skip_disliked = Pomijaj utwory, których nie lubisz
settings.account.skip_disliked_desc = Oznaczenie odtwarzanego utworu jako „Nie lubię” przechodzi do następnego. Utwory oznaczone „Nie lubię” i tak nie trafiają do radia ani autoodtwarzania.
settings.account.accounts_group = Konta
settings.account.channels = Kanały (konta marki) tego konta Google:
settings.account.google_index = Konto Google
settings.account.google_index_desc = Twoje logowanie może obejmować kilka kont Google, jak na youtube.com. Wybierz, którego używa {app}.
settings.account.google_single = To logowanie obejmuje jedno konto Google. Aby używać kilku, zaloguj się na każde w music.youtube.com w przeglądarce, wyloguj się tutaj i wklej plik cookie z tej przeglądarki.
settings.account.cookie_note = Logowanie używa pliku cookie sesji przeglądarki dla music.youtube.com. Jest przechowywany w pęku kluczy systemu i wysyłany tylko do YouTube. Funkcje konta zbudowano w oparciu o internetowe API YouTube, ale nie zostały jeszcze sprawdzone na prawdziwym koncie.

