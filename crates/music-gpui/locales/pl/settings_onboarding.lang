# ---- Welcome step: feature list
onboarding.feature.browse.title = Przeglądanie i wyszukiwanie
onboarding.feature.browse.text = Strona główna, listy przebojów, nastroje, nowości, wykonawcy, albumy i playlisty.
onboarding.feature.lyrics.title = Teksty
onboarding.feature.lyrics.text = Teksty synchronizowane słowo po słowie od wielu dostawców, z tłumaczeniem i latynizacją.
onboarding.feature.library.title = Biblioteka
onboarding.feature.library.text = Polubienia, playlisty, historia słuchania, statystyki i pobrane pliki — przechowywane na tym komputerze.
onboarding.feature.recognize.title = Rozpoznawanie muzyki
onboarding.feature.recognize.text = Rozpoznaj utwór, który gra wokół Ciebie (⇧⌘R), i od razu go odtwórz.

