# ---- Step subtitles
onboarding.subtitle.welcome = Szybki, natywny odtwarzacz YouTube Music: przeglądanie i wyszukiwanie, teksty podążające za utworem, biblioteka z historią i statystykami, Twoje własne pliki muzyczne i rozpoznawanie utworów. Kilka wyborów i gotowe — wszystko to możesz później zmienić w Ustawieniach.
onboarding.subtitle.content = W jakim języku YouTube Music pokazuje tytuły i rekomendacje oraz listy przebojów i nowości z którego kraju widzisz.
onboarding.subtitle.theme = Wybierz motyw i rozmiar tekstu.
onboarding.subtitle.account = Opcjonalne. Po zalogowaniu pojawią się Twoje polubienia, biblioteka, playlisty i spersonalizowane rekomendacje. Wszystko inne działa bez konta.
onboarding.subtitle.local_files = Opcjonalne. Dodaj foldery z plikami muzycznymi; zostaną zeskanowane do biblioteki i będą odtwarzane obok YouTube Music.
onboarding.subtitle.privacy = Co warto wiedzieć na początek.

