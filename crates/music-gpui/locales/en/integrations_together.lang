# Music Together (Listen together): src/integrations/together.rs and
# src/pages/together.rs. Format: see crates/music-gpui/i18n_parse.rs.
# {name} is a person's display name; {reason} / {error} is text from the network
# layer or the other side (stays English).

# ---- Activity log and notifications
together.log.started_port = Session started on port {port}
together.log.started_relay = Session started through {relay}
together.toast.started = Music Together session started
together.toast.started_relay = Music Together session started (relay)
together.error.start_failed = Couldn't start on port {port}: {error}
together.error.no_relay = Set a relay server in Settings → Music Together first.
together.error.relay_failed = Couldn't host through {relay}: {error}
# {relay}: the relay's address; {error}: the network's reason (English).
together.log.relay_unreachable = Couldn't reach the relay {relay}: {error}
# Shown when "Over the internet" was chosen but the relay didn't answer: the session runs on the LAN.
together.error.relay_unreachable = Relay unreachable, guests must be on the same network
together.log.no_code = The relay gave no room code ({error}); share the link instead.
# {code}: the room code, like ABCD-EFGH.
together.log.code = Room code {code}
# Keep "ABCD-EFGH" (an example code: 8 letters and digits).
together.error.bad_code = That isn't a room code: 8 letters and digits, like ABCD-EFGH.
together.error.code_not_found = No session has that code. Check it, or ask the host for the current one.
together.error.code_rate_limited = Too many tries. Wait a minute, then try again.
together.error.code_unsupported = The relay {relay} doesn't support room codes; ask the host for the link.
together.error.relay_join_failed = Couldn't look up the code at {relay}: {error}
together.log.handing_over = Handing the session to {name}…
together.log.hand_over_failed = Couldn't hand the session over
together.log.wants_to_join = {name} wants to join
# Notification ("Listen together" is the page's name in the sidebar).
together.toast.wants_to_join = {name} wants to join (Listen together)
together.log.joined = {name} joined
together.log.left = {name} left ({reason})
# {title}: song title.
together.log.suggested = {name} suggested “{title}”
together.log.new_host = {name} is the host now
together.log.transfer_failed = Couldn't hand the session to {name}: {reason}
together.log.transfer_failed_guest = Couldn't hand the session to the guest: {reason}
together.error.session_ended = Session ended: {reason}
together.toast.ended = Music Together: {reason}
together.error.bad_link = That isn't a Music Together link (it needs host, port, session and key).
together.log.connected = Connected to {host}
together.toast.joined = Joined the Music Together session
together.error.join_failed = Couldn't join: {error}
together.log.handing_to_you = The host is handing the session to you…
together.error.take_over_failed = Couldn't take over the session: {error}
together.log.you_are_host = You're the host now
together.toast.you_are_host = You're the host of the Music Together session now
together.log.ended = Session ended
together.log.left_session = Left the session
together.toast.no_suggestions = The host doesn't take suggestions in this session
together.toast.only_youtube_music = Only YouTube Music songs can be suggested
together.toast.suggested_title = Suggested “{title}” to the host
together.toast.suggested.one = Suggested {count} song to the host
together.toast.suggested.other = Suggested {count} songs to the host
together.toast.no_control = The host doesn't let guests control playback
together.status.waiting_approval = Waiting for the host to let you in…
together.status.let_in = The host let you in
together.status.declined = The host declined
together.status.disconnected = Disconnected
together.log.host_changed = {name} is the host now; reconnecting…
together.log.host_changed_unknown = Someone else is the host now; reconnecting…
