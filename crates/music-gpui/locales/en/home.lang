home.quick_picks = Quick picks
home.section.community = Community playlists
# Songs, albums, artists and playlists the user pinned from a context menu.
home.section.speed_dial = Speed dial
home.section.keep_listening = Keep listening
home.section.account_playlists = Your YouTube playlists
# Songs played a lot some time ago and rarely lately.
home.section.forgotten_favorites = Forgotten favourites
# The rows of recommendations "Similar to <artist or song>".
home.section.similar = Similar to…
home.section.feed = YouTube Music feed
