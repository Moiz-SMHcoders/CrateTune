# Integrations on top of the player: SponsorBlock, Chromecast, the AI content
# filter and playlist import / export (src/integrations/*, src/pages/import.rs).
# Format: see crates/music-gpui/i18n_parse.rs ({name} = placeholder, {app} = the
# app's name, `.one` / `.other` = plural forms). Brand names (SponsorBlock,
# Chromecast, Spotify, YouTube Music, Exportify) stay as they are.

# ---- SponsorBlock: segment categories (as SponsorBlock's own UI names them)
sponsorblock.category.music_offtopic = Non-music section
sponsorblock.category.sponsor = Sponsor
sponsorblock.category.intro = Intermission / intro
sponsorblock.category.outro = Endcards / credits
sponsorblock.category.selfpromo = Self-promotion
sponsorblock.category.interaction = Interaction reminder
sponsorblock.category.preview = Preview / recap
sponsorblock.category.filler = Filler tangent
sponsorblock.category.hook = Hook / greetings
# The same categories as they read inside "Skip {category}" on the player-bar chip
# (lowercase in English; keep short).
sponsorblock.category_in_chip.music_offtopic = non-music section
sponsorblock.category_in_chip.sponsor = sponsor
sponsorblock.category_in_chip.intro = intermission / intro
sponsorblock.category_in_chip.outro = endcards / credits
sponsorblock.category_in_chip.selfpromo = self-promotion
sponsorblock.category_in_chip.interaction = interaction reminder
sponsorblock.category_in_chip.preview = preview / recap
sponsorblock.category_in_chip.filler = filler tangent
sponsorblock.category_in_chip.hook = hook / greetings
# Notification after an automatic skip. {category}: a category name above;
# {seconds}: length of the skipped part.
sponsorblock.toast.skipped = Skipped: {category} ({seconds} s)
# Player-bar chip (keep short). {category}: sponsorblock.category_in_chip.*;
# {seconds}: seconds left in the segment.
sponsorblock.chip.skip = Skip {category} ({seconds}s)
sponsorblock.chip.tooltip = SponsorBlock: skip to the end of this segment

