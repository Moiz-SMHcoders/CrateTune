modules.needs_configuration = Needs configuration: {settings}
modules.settings_heading = Settings
modules.no_settings = This module has no settings.
# Text-field placeholders in a module's settings form.
modules.field.placeholder_required = required
modules.field.placeholder_optional = optional
# Form errors; {field} = the setting's name (from the module).
modules.field.not_a_number = {field} must be a number.
modules.field.required = {field} is required.
modules.field.invalid = {field} has an invalid value.

