# Settings → Modules (src/settings/modules.rs): provider modules (`.arch` packages)
# that supply audio from other sources. Module names, descriptions and setting
# labels come from the modules themselves and are not translated here.

# ---- Playback source
modules.source.group = Playback source
# Choice buttons.
modules.source.youtube = YouTube only
modules.source.first = Modules first, then YouTube
modules.source.only = Modules only
modules.source_note.youtube = Songs play from YouTube; installed modules are not used.
# {count} = number of enabled modules.
modules.source_note.first.one = Each song is looked up in the {count} enabled module, top to bottom; the first acceptable match plays, otherwise YouTube.
modules.source_note.first.other = Each song is looked up in the {count} enabled modules, top to bottom; the first acceptable match plays, otherwise YouTube.
# “Skip failing songs” is a setting under Playback.
modules.source_note.only.one = Songs play only from the {count} enabled module; a song no module can match fails (and is skipped when “Skip failing songs” is on).
modules.source_note.only.other = Songs play only from the {count} enabled modules; a song no module can match fails (and is skipped when “Skip failing songs” is on).
modules.source.note = A module supplies audio for the song you play; title, artists and your library stay the same. The bar and Now Playing show where the audio comes from. Downloads use the same order.

# ---- Unavailable
modules.unavailable = Modules are unavailable.
modules.no_data_dir = No data directory; modules are unavailable.
# {error} = an English technical error message.
modules.unavailable_error = Modules unavailable: {error}

# ---- Add a module
modules.add.group = Add a module
# Buttons.
modules.add.from_file = Install from file…
modules.add.from_file_note = An .arch package from your disk.
modules.add.from_url = Install from URL
modules.add.catalog = Add catalog
modules.add.note = Packages are checked (format, checksum, settings, exported functions) before you confirm. No module or catalog is preinstalled: modules come from their authors, and run sandboxed (no files, network through the app's proxy).
modules.url_missing = Enter the URL of an .arch package, descriptor or catalog.
modules.catalog_url_missing = Enter a catalog URL.

