# Group heading; {count} = number of installed modules.
modules.installed_group = Installed ({count})
modules.nothing_installed = Nothing installed yet.
# Small buttons on each module card (keep short).
modules.action.settings = Settings
modules.action.check = Check
modules.action.check_update = Check for update
modules.action.uninstall = Uninstall
# The same button after one press: press again to remove.
modules.action.confirm_remove = Remove — sure?
# Tooltips of the up / down arrow buttons (order in which modules are tried).
modules.action.higher = Higher priority
modules.action.lower = Lower priority
