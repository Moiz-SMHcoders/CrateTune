modules.busy.saving = Saving…
modules.busy.saving_catalog = Saving catalog…
modules.busy.checking_package = Checking the package…
modules.busy.reading_catalog = Reading the catalog…
modules.busy.installing = Installing…
modules.busy.removing = Removing…
modules.busy.checking = Checking…
modules.busy.checking_update = Checking for an update…
modules.busy.loading_settings = Loading settings…
modules.busy.saving_settings = Saving settings…
modules.busy.refreshing = Refreshing…

# ---- Results
# {name} = the catalog's name, {count} = its number of entries.
modules.catalog_added.one = Added catalog “{name}” ({count} entry).
modules.catalog_added.other = Added catalog “{name}” ({count} entries).
# {name} = the module's name. “Save” is the button under its settings.
modules.installed_needs_setup = Installed {name}. Fill in its settings and press Save.
modules.installed = Installed {name}.
modules.removed = Module removed.
modules.update_available = Version {version} is available.
modules.up_to_date = Up to date.
modules.update_from_file = Installed from a file: import the new package to update.
modules.settings_read_failed = Couldn't read this module's settings.
modules.settings_saved = Settings saved.
modules.catalog_refreshed = Catalog refreshed.
modules.diagnostics_copied = Diagnostics copied.

# ---- Review card (before installing)
modules.review.group = Review
modules.review.replaces = Updates the installed version {version}; its settings are kept.
modules.review.new = A new installation, added at the end of the playback order.
# {settings} = a list of the module's setting names.
modules.review.needs = Needs: {settings}.
modules.review.homepage = Homepage: {url}
modules.review.license = License: {license}
# {hash} = a long hex checksum.
modules.review.sha256 = Package SHA-256 {hash}

