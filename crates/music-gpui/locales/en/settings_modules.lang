modules.diagnostic_track = {line} — {track}
modules.diag.last_song = Last song
modules.diag.check = Check
modules.diag.playback = Playback
modules.diag.not_checked = Not checked yet.
modules.diag.not_used = Not used for a song yet.
# {when} = "5 min ago", {hash} = the start of a hex checksum, {url} = an update URL.
modules.installed_line_file = Installed {when} · package {hash} · from a file
modules.installed_line_url = Installed {when} · package {hash} · from {url}
modules.log_empty = The log is empty.
# Buttons.
modules.copy_diagnostics = Copy diagnostics
modules.clear_log = Clear log

