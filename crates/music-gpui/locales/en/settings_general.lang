# Placeholders of the scrobbling / Discord text fields.
settings.panel.placeholder.api_key = API key
settings.panel.placeholder.shared_secret = Shared secret
settings.panel.placeholder.user_token = User token
settings.panel.placeholder.application_id = Application ID
