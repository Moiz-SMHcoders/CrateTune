settings.panel.secrets.file_keychain_disabled = settings file (0600; keychain disabled)
settings.panel.secrets.file_keychain_read_failed = settings file (0600; keychain read failed)
settings.panel.secrets.file_keychain_unavailable = settings file (0600; keychain unavailable)

# ---- Credential stores (src/secrets.rs): the OS's own names for them.
secrets.backend.macos = macOS Keychain
secrets.backend.windows = Windows Credential Manager
secrets.backend.secret_service = Secret Service

# ---- Settings file problems (shown in Storage and Scrobbling)
settings.file.no_config_dir = no config directory; settings are not saved
# {error} = an English technical error message.
settings.file.save_failed = saving failed: {error}
# {path} = the settings file's path.
settings.file.read_failed = reading {path}: {error}
# {backup} = the path the broken file was moved to.
settings.file.invalid_moved = {path} is not valid ({error}); moved to {backup}

# ---- Google sign-in window (macOS, Windows; src/login_webview/)
# Window title.
login.window_title = Sign in to YouTube Music
# Status bar above the sign-in page.
login.instructions = Sign in with your Google account. This window closes once YouTube Music opens.
# {error} = an English technical error message. “Paste cookie” is the button
# settings.account.paste_cookie.
login.webview_failed = The web view couldn't be created ({error}). Use “Paste cookie” instead.
login.checking = Signed in — checking the account…
# Windows: shown when "Sign in with Google…" can't open its window; the paste-cookie
# dialog opens next. “Paste cookie” is the button settings.account.paste_cookie.
login.webview2_missing = Signing in with Google needs the Microsoft Edge WebView2 Runtime, which isn't installed. Install it from microsoft.com/edge/webview2, or use “Paste cookie”.
