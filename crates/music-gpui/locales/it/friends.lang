settings.friends.owner = Proprietario
settings.friends.remove = Rimuovi
settings.friends.invite = Invita
settings.friends.leave = Esci
settings.friends.invite_shown = Il tuo amico inserisce questo codice in Impostazioni → Amici → Unisciti a un gruppo:
settings.friends.invite_expires = Valido per 10 minuti, una sola volta. Su un'altra rete invia invece il link (o fai scansionare il codice QR).
settings.friends.create = Crea un gruppo
settings.friends.group_placeholder = Nome del gruppo
settings.friends.create_button = Crea
settings.friends.join = Unisciti a un gruppo
settings.friends.join_button = Unisciti
