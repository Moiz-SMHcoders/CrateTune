# Friend groups (see locales/en/friends.lang).

# The Settings section's name.
settings.section.friends = Amici

# ---- Settings → Friends
settings.friends.title = Gruppi di amici
settings.friends.intro = Tieni un gruppo di amici invece di una nuova stanza di Music Together ogni volta: guarda cosa stanno ascoltando e avvia una sessione per tutto il gruppo con un clic.
settings.friends.enabled = Usa i gruppi di amici
settings.friends.enabled_desc = Disattivato per impostazione predefinita. Il tuo computer comunica quindi direttamente con i computer dei tuoi amici, con crittografia end-to-end.
settings.friends.privacy = Cosa vedono gli amici: il tuo nome e, solo mentre la condivisione è attiva, il brano che riproduci (titolo, artista, il suo id YouTube, quando è iniziato). Nulla viene memorizzato su un server: il relay inoltra solo dati cifrati e vede il tuo indirizzo IP. I gruppi sono conservati sul computer di ogni membro.

settings.friends.you = Tu
settings.friends.name = Nome
settings.friends.name_note = Come ti vedono i tuoi amici.
settings.friends.share = Condividi cosa sto ascoltando
settings.friends.share_desc = I tuoi amici vedono nel loro feed il brano che riproduci. I brani dei tuoi file non vengono mai condivisi.
settings.friends.private = Sessione privata
settings.friends.private_desc = Sospendi la condivisione finché non chiudi l'app.
settings.friends.member_id = Id membro: {id}

settings.friends.groups = I tuoi gruppi
settings.friends.no_groups = Ancora nessun gruppo. Creane uno e invita i tuoi amici, oppure unisciti a uno con il codice che ti mostra un amico.
