settings.friends.recovery = Frase di recupero
settings.friends.recovery_note = I tuoi amici ti riconoscono da una chiave conservata su questo computer. Annota la frase di recupero per spostare quella chiave su un nuovo computer; chiunque la possieda può parlare a nome tuo.
settings.friends.show_phrase = Mostra frase di recupero
settings.friends.hide_phrase = Nascondi
settings.friends.copy_phrase = Copia
settings.friends.restore = Ripristina da una frase di recupero
settings.friends.phrase_placeholder = XXXXX-XXXXX-…
settings.friends.restore_button = Ripristina
settings.friends.restore_note = Sostituisce la chiave di questo computer. I suoi gruppi vengono dimenticati qui: chiedi a un membro (o al tuo vecchio computer) un invito per ciascuno, e tornerai con il tuo nome.

# ---- Joining errors
friends.join.not_found = Nessuno su questa rete sta mostrando un invito. Chiedi il link di invito se il tuo amico è su un'altra rete.
friends.join.wrong_code = Il codice non corrisponde. Controllalo e riprova.
friends.join.not_inviting = Quell'invito non è più valido. Chiedine uno nuovo.
friends.join.failed = Impossibile unirsi: {error}
friends.join.bad_code = Non è un codice di invito. Un codice ha 8 lettere e cifre, come ABCD-2345.

