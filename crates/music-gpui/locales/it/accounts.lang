settings.account.from_browser = Accedi dal tuo browser…
settings.account.browser_note = «Accedi dal tuo browser» riprende l’accesso a YouTube di un browser di questo computer (Chrome, Edge, Brave, Firefox, Safari, Arc, Vivaldi, Opera, Chromium), così non devi accedere di nuovo.
settings.account.in_use = In uso
settings.account.switch = Passa
settings.account.remove = Rimuovi questo account
settings.account.list_group = I tuoi account
settings.account.add = Aggiungi un account
settings.account.add_desc = Accedi a un altro account YouTube Music; passa dall’uno all’altro qui o dal menu dell’account nella barra del titolo.
settings.account.list_note = Brani piaciuti, album salvati, iscrizioni e playlist di YouTube appartengono all’account in uso e vengono risincronizzati quando cambi. File locali, playlist locali, cronologia di ascolto e download sono condivisi da tutti gli account.
settings.account.report_plays = Aggiungi gli ascolti alla mia cronologia YouTube
settings.account.report_plays_desc = Ciò che ascolti qui compare nella cronologia di YouTube Music sugli altri dispositivi e migliora i consigli. Non viene inviato nulla mentre la cronologia di ascolto è in pausa.
browser_import.title = Accedi dal tuo browser
browser_import.intro = Scegli un profilo del browser in cui hai effettuato l’accesso a music.youtube.com. {app} legge solo i suoi cookie di youtube.com, su questo computer, e li conserva nel portachiavi come ogni accesso.
browser_import.note.keychain = macOS chiederà se {app} può usare «<browser> Safe Storage» dal tuo portachiavi. È previsto: è la chiave dei cookie del browser. Scegli Consenti.
browser_import.note.app_bound = Nelle versioni recenti di Windows, Chrome, Edge e Brave riservano i cookie a sé stessi (crittografia legata all’app). Questi profili sono elencati ma non leggibili; usa Firefox, «Accedi con Google…» o un cookie incollato.
browser_import.none_found = Su questo computer non è stato trovato alcun browser supportato con cookie salvati.
browser_import.import = Importa
browser_import.last_used = Ultimo uso {date}
browser_import.blocked.app_bound = Bloccato dal browser (crittografia legata all’app)
browser_import.blocked.no_key = Chiave dei cookie del browser non trovata
browser_import.blocked.full_disk_access = Richiede l’accesso completo al disco (Impostazioni di Sistema → Privacy e sicurezza)
browser_import.reading = Lettura dell’accesso a YouTube da {browser}…
browser_import.error.not_found = L’archivio dei cookie di {browser} non c’è più.
browser_import.error.locked = {browser} blocca i suoi cookie mentre è aperto. Chiudi {browser} e riprova.
browser_import.error.full_disk_access = {app} ha bisogno dell’accesso completo al disco per leggere i cookie di Safari: Impostazioni di Sistema → Privacy e sicurezza → Accesso completo al disco.
browser_import.error.permission = {app} non può leggere i cookie di {browser}.
browser_import.error.keychain = macOS non ha fornito «{browser} Safe Storage», la chiave dei cookie di {browser}. Riprova e scegli Consenti quando macOS lo chiede.
browser_import.error.no_key = Chiave dei cookie di {browser} non trovata.
browser_import.error.app_bound = Su questa versione di Windows {browser} riserva i cookie a sé stesso (crittografia legata all’app): nessun’altra app può leggerli. Usa Firefox, «Accedi con Google…» o un cookie incollato.
browser_import.error.decrypt = Impossibile decifrare i cookie di {browser}.
browser_import.error.not_signed_in = {browser} ({profile}) non ha effettuato l’accesso a YouTube. Accedi prima a music.youtube.com in quel browser.
browser_import.error.format = Impossibile leggere l’archivio dei cookie di {browser}.
