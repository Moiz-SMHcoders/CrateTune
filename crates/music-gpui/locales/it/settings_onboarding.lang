onboarding.feature.browse.text = Home, classifiche, mood, nuove uscite, artisti, album e playlist.
onboarding.feature.lyrics.title = Testi
onboarding.feature.lyrics.text = Testi sincronizzati parola per parola da molti fornitori, con traduzione e romanizzazione.
onboarding.feature.library.title = Libreria
onboarding.feature.library.text = Mi piace, playlist, cronologia di ascolto, statistiche e download, salvati su questo computer.
onboarding.feature.recognize.title = Riconosci musica
onboarding.feature.recognize.text = Identifica un brano che suona intorno a te (⇧⌘R) e riproducilo subito.

