# ---- Appearance
settings.appearance.theme = Tema
settings.appearance.theme_note = Dinamico prende il colore di accento dalla copertina del brano in riproduzione (il colore vivace più frequente, regolato per restare leggibile sullo sfondo scuro).
settings.appearance.text_size = Dimensione del testo
settings.appearance.font_scale = {percent}%
settings.appearance.text_size_note = Ridimensiona tutto il testo dell'interfaccia; i testi delle canzoni mantengono la loro dimensione (Testi).
settings.appearance.background = Sfondo
settings.appearance.np_note = Sfumatura, tinta unita e bagliore prendono i colori dalla copertina. Il bagliore si muove solo durante la riproduzione. Layout e sfondo si trovano anche nel menu layout della schermata In riproduzione.
settings.appearance.mini_player = Mini player

# ---- Playback
settings.playback.queue = Coda
settings.playback.shuffle = Casuale
settings.playback.shuffle_desc = Mantiene per primo il brano attuale; disattivandola si ripristina l'ordine.
settings.playback.repeat = Ripeti
settings.playback.repeat_desc = Memorizzato tra un avvio e l'altro (⌘R per cambiare modalità).
settings.playback.repeat_all = Tutti
settings.playback.repeat_one = Uno
settings.playback.audio = Audio
settings.playback.streams = Stream di YouTube
settings.playback.stream_auto = Brani completi: client TV, poi client web con un PoToken, poi un'anteprima di circa 1 min.
settings.playback.stream_tv = Brani completi tramite il client TV (senza PoToken); un'anteprima se non funziona.
settings.playback.stream_web = Brani completi tramite il client web e un PoToken BotGuard (macOS / Windows); un'anteprima se non funziona.
settings.playback.stream_preview = Solo il primo minuto circa di ogni brano (il vecchio comportamento).
settings.playback.quality = Qualità dello streaming
settings.playback.quality_desc = Bassa riduce i dati; Alta preferisce Opus (~160 kbps) ad AAC 128.
settings.playback.normalize = Normalizzazione del volume
settings.playback.normalize_desc = Uniforma il volume con i dati di loudness di YouTube e i tag ReplayGain.
settings.playback.skip_silence = Salta il silenzio
settings.playback.skip_silence_desc = Elimina il silenzio all'inizio e alla fine dei brani e accorcia le lunghe pause silenziose.
settings.playback.auto_skip = Salta i brani che non si caricano
settings.playback.auto_skip_desc = Passa al successivo invece di fermarsi (fino a 3 di fila).
settings.playback.transitions = Transizioni
settings.playback.crossfade = Dissolvenza incrociata
settings.playback.crossfade_value = {seconds} s
settings.playback.transitions_note = La riproduzione è senza pause: il brano successivo viene precaricato circa 30 s prima e parte dal campione immediatamente seguente. La dissolvenza incrociata fonde i due (anche prima che un'anteprima finisca in anticipo).
settings.playback.speed_pitch = Velocità e tono
settings.playback.speed = Velocità
settings.playback.speed_value = {speed}×
settings.playback.pitch = Tono
settings.playback.pitch_value = {value} st
settings.playback.speed_pitch_note = La velocità mantiene il tono; il tono mantiene la velocità.
settings.playback.output = Dispositivo di uscita
settings.playback.system_default = Predefinito di sistema
settings.playback.device_missing = {device} (non connesso)
settings.playback.device_current_default = {device} (predefinito attuale)
settings.playback.playing_through = Riproduzione su {device}
settings.playback.output_note = Se un dispositivo manca si usa quello predefinito di sistema, e il dispositivo viene ripreso quando torna disponibile.
settings.playback.sleep = Timer di spegnimento
settings.playback.sleep_custom_button = {minutes} min (personalizzato)
settings.playback.end_of_track = Fine del brano
settings.playback.turn_off = Disattiva
settings.playback.sleep_armed = Mette in pausa la riproduzione: {when}
settings.playback.custom_length = Durata personalizzata
settings.playback.sleep_note = Disponibile anche nella barra del player e nella schermata In riproduzione (icona della luna).

# ---- Equalizer
settings.eq.preset.flat = Piatto
settings.eq.preset.bass = Bassi
settings.eq.preset.vocal = Voce
settings.eq.preset.treble = Alti
settings.eq.preset.loudness = Loudness
settings.eq.note = Applicato in tempo reale. Le amplificazioni vengono compensate in modo che l'uscita non saturi mai.

# ---- Lyrics
settings.lyrics.look = Aspetto
settings.lyrics.animation = Animazione
settings.lyrics.animation_note = Karaoke: passata morbida con parole sollevate · Apple: passata più ampia, parola luminosa · Scorrimento: passata netta, le parole salgono · Bagliore: alone intorno alle parole cantate · Dissolvenza: le parole compaiono in dissolvenza · Nessuna: la riga si illumina. Le animazioni per parola richiedono testi sincronizzati per parola; con testi sincronizzati per riga si illumina l'intera riga.
settings.lyrics.text_size = Dimensione del testo
settings.lyrics.text_size_value = {size} px
settings.lyrics.line_spacing = Interlinea
settings.lyrics.line_spacing_value = {spacing}×
settings.lyrics.alignment = Allineamento
settings.lyrics.bg_vocals = Cori e duetti
settings.lyrics.bg_vocals_desc = I cori sotto la loro riga; un secondo cantante sul lato opposto.
settings.lyrics.providers = Fornitori
settings.lyrics.providers_note = Interrogati in quest'ordine (più di uno alla volta); vince il risultato migliore. Fai clic su una riga in In riproduzione per spostarti lì; il pulsante di ricarica cerca di nuovo.
settings.lyrics.cached_only = senza chiave solo brani in cache
settings.lyrics.needs_key = richiede una chiave API
settings.lyrics.prefer_word = Preferisci testi sincronizzati per parola
settings.lyrics.prefer_word_desc = Un risultato sincronizzato per parola batte uno sincronizzato per riga di un fornitore più in alto.
settings.lyrics.reset_order = Ripristina ordine
settings.lyrics.keys_note = Le chiavi API vengono salvate nel portachiavi quando il campo perde il focus o con Invio.
settings.lyrics.translation = Traduzione
settings.lyrics.translate = Traduci il testo
settings.lyrics.translate_desc = Aggiunge una riga tradotta sotto ogni riga (anche con il pulsante di traduzione in In riproduzione).
settings.lyrics.translator = Traduttore
settings.lyrics.translator_ai = IA (compatibile con OpenAI)
settings.lyrics.language = Lingua
settings.lyrics.endpoint = Endpoint
settings.lyrics.model = Modello
settings.lyrics.api_key = Chiave API
settings.lyrics.translation_note = Codici lingua come en, de, ja, zh-CN. Ogni brano viene tradotto una volta per lingua e traduttore e conservato nella libreria. L'endpoint gratuito di Google ha un limite di richieste: dopo un rifiuto viene lasciato stare per un po' (2 min, di più se continua a rifiutare) e poi la traduzione viene ritentata.
settings.lyrics.ai_missing = Imposta l'endpoint e il modello IA in Impostazioni → Testi.
settings.lyrics.romanization = Romanizzazione
settings.lyrics.romanization_note = Aggiunge una riga in caratteri latini sotto le righe scritte in questi sistemi di scrittura.
settings.lyrics.kanji = Letture dei kanji (giapponese)
settings.lyrics.kanji_embedded = Incluso in questa versione.
settings.lyrics.kanji_missing = Senza di esso i kanji restano invariati e vengono romanizzati solo i kana. Scarica {download} una sola volta ({disk} su disco).
settings.lyrics.kanji_download = Scarica ({size})
settings.lyrics.kanji_downloading = Download… {done} di {total}
settings.lyrics.kanji_ready = {name} · {size} su disco.
settings.lyrics.kanji_failed = Download non riuscito: {error}
