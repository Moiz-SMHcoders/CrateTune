# Settings: Account, Network and About sections, the settings panel, the update
# check and the Google sign-in window.

# ---- Account
settings.account.cookie_title = Inloggen met een browsercookie
settings.account.cookie_steps = 1. Open music.youtube.com in je browser en log in.\n2. Open de ontwikkelaarstools (⌥⌘I in Safari / Chrome) → Netwerk en laad de pagina opnieuw.\n3. Klik op een willekeurig verzoek aan music.youtube.com (bijv. ‘browse’), zoek ‘Cookie’ onder Request Headers en kopieer de hele waarde.\n4. Plak die hieronder. Hij wordt opgeslagen in de sleutelhanger van het systeem en alleen naar YouTube gestuurd.
settings.account.cookie_index = Google-accountindex (als er meerdere zijn ingelogd):
settings.account.not_signed_in = Niet ingelogd. Alles werkt anoniem; met inloggen worden je leuke nummers, opgeslagen albums, abonnementen en playlists naar de bibliotheek gesynchroniseerd, en likes en playlistwijzigingen gaan terug naar YouTube Music.
settings.account.sign_in_google = Inloggen met Google…
settings.account.paste_cookie = Cookie plakken…
settings.account.google_refused = Als Google het inlogvenster weigert (‘Deze browser of app is mogelijk niet veilig’), gebruik dan ‘Cookie plakken’.
settings.account.last_synced = Laatst gesynchroniseerd op {date}
settings.account.not_synced = Nog niet gesynchroniseerd
settings.account.sync_now = Nu syncen
settings.account.syncing = Syncen…
settings.account.sync_group = Bibliotheeksynchronisatie
settings.account.sync_row = Je YouTube Music-bibliotheek synchroniseren
settings.account.sync_row_desc = Leuke nummers, bibliotheeknummers, opgeslagen albums, abonnementen, playlists.
settings.account.accounts_group = Accounts
settings.account.channels = Kanalen (merkaccounts) van dit Google-account:
settings.account.google_index = Google-account
settings.account.google_index_desc = Je login kan meerdere Google-accounts bevatten, zoals op youtube.com. Kies welke {app} gebruikt.
settings.account.google_single = Deze login bevat één Google-account. Wil je er meerdere gebruiken, log dan in een browser bij music.youtube.com met elk account in, meld je hier af en plak de cookie van die browser.
settings.account.cookie_note = Inloggen gebruikt de sessiecookie van je browser voor music.youtube.com. Die wordt bewaard in de sleutelhanger van het systeem en alleen naar YouTube gestuurd. Accountfuncties zijn gebouwd op de web-API van YouTube, maar nog niet getest met een echt account.

