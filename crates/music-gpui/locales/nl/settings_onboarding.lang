# ---- Step subtitles
onboarding.subtitle.welcome = Een snelle, native speler voor YouTube Music: bladeren en zoeken, songteksten die met het nummer meelopen, een bibliotheek met geschiedenis en statistieken, je eigen muziekbestanden en nummerherkenning. Een paar keuzes en je bent klaar — alles hier kun je later wijzigen in Instellingen.
onboarding.subtitle.content = In welke taal YouTube Music titels en aanbevelingen toont, en van welk land je de hitlijsten en releases ziet.
onboarding.subtitle.theme = Kies een thema en tekstgrootte.
onboarding.subtitle.account = Optioneel. Inloggen brengt je likes, bibliotheek, playlists en persoonlijke aanbevelingen mee. Al het andere werkt zonder account.
onboarding.subtitle.local_files = Optioneel. Voeg mappen met muziekbestanden toe; ze worden in je bibliotheek ingelezen en spelen naast YouTube Music.
onboarding.subtitle.privacy = Wat je moet weten voordat je begint.

