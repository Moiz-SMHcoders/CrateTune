# ---- Self-update (Settings → About → Updates, notifications, menu; src/update_check.rs,
# src/settings/about.rs). The older update.* keys are in settings_general.lang.

# Menu item (macOS: app menu under "About"; elsewhere: Help menu). Also a shortcut label.
menu.check_updates = Controleer op updates…

# Buttons. {version} = a version number such as 0.2.0.
update.update_to = Update naar {version}
# Notification button: download and install the update that was found.
update.update_now = Update
update.restart = Herstart om af te ronden
update.retry = Probeer opnieuw
# Opens the release page in the browser.
update.download_manually = Download handmatig

# Status lines.
# {progress} = update.progress, or just the amount downloaded ("12.3 MB").
update.downloading = {version} downloaden… {progress}
# {done}, {total} = sizes such as "12.3 MB".
update.progress = {done} van {total}
update.ready = Versie {version} is gedownload en geverifieerd. Herstart om de update af te ronden.
update.installing = {version} installeren…

# Switches.
update.auto_check = Automatisch controleren op updates
update.auto_check_detail = Wanneer {app} start en elke 24 uur zolang het actief is.
update.auto_install = Updates automatisch installeren
update.auto_install_detail = Downloadt updates op de achtergrond en vraagt je om te herstarten. Stop je in plaats daarvan, dan wordt de update op dat moment geïnstalleerd.
update.prereleases = Pre-releases opnemen
update.prereleases_detail = Testversies die vóór een stabiele release verschijnen. Standaard aan zolang je een pre-release gebruikt (elke 0.x-versie).

# Notifications.
update.ready_toast = {app} {version} staat klaar. Herstart om de update af te ronden.
# {error} = one of the update.error.* messages.
update.failed_toast = De update is mislukt. {error}

# Errors, in plain words. "Nothing was installed" = the current version is unchanged.
# {error} = an English technical detail.
update.error.network = Kan GitHub niet bereiken ({error}). Controleer je internetverbinding of proxy.
update.error.bad_response = GitHub stuurde een onverwacht antwoord ({error}).
update.error.untrusted = De downloadlink verwijst niet naar de GitHub-releases van deze app en is daarom niet gevolgd.
update.error.no_asset = Deze release heeft geen pakket voor jouw systeem. Download het handmatig.
update.error.no_checksums = Deze release heeft geen checksumbestand, dus de download kan niet worden geverifieerd. Er is niets geïnstalleerd.
update.error.not_listed = Het checksumbestand van de release bevat dit pakket niet, dus het kan niet worden geverifieerd. Er is niets geïnstalleerd.
update.error.mismatch = De download komt niet overeen met de checksum van de release. Hij is verwijderd en er is niets geïnstalleerd.
update.error.cancelled = Download geannuleerd.
# {path} = a folder.
update.error.not_writable = {app} kan zichzelf niet vervangen omdat je gebruiker niet naar {path} kan schrijven. Download de nieuwe versie handmatig.
update.error.dev_build = Deze kopie is niet vanuit een releasepakket geïnstalleerd (hij is bijvoorbeeld vanuit de broncode gebouwd) en kan zichzelf dus niet updaten.
update.error.translocated = macOS voert deze kopie uit vanaf een tijdelijke, alleen-lezen locatie. Verplaats {app} naar je map Programma's, open het vanaf daar en probeer het opnieuw.
update.error.system_package = Deze kopie is met een pakketbeheerder geïnstalleerd. Update hem daar.
update.error.invalid = Het gedownloade pakket is ongeldig ({error}). Er is niets geïnstalleerd.
update.error.io = Kan de download niet opslaan ({error}).
update.error.install = Installeren is mislukt en de huidige versie is ongewijzigd ({error}).
