# ---- Appearance
settings.appearance.theme = Thema
settings.appearance.theme_note = Dynamisch neemt het accent over van de cover van het nummer dat speelt (de meest voorkomende levendige kleur, aangepast zodat die leesbaar blijft op de donkere achtergrond).
settings.appearance.text_size = Tekstgrootte
settings.appearance.font_scale = {percent}%
settings.appearance.text_size_note = Schaalt alle tekst van de interface; songteksten houden hun eigen grootte (Songteksten).
settings.appearance.background = Achtergrond
settings.appearance.np_note = Verloop, effen kleur en gloed nemen hun kleuren over van de cover. De gloed beweegt alleen als er muziek speelt. Indeling en achtergrond staan ook in het indelingsmenu van het scherm Speelt nu.
settings.appearance.np_fullscreen = Volledig scherm bij openen van Speelt nu
settings.appearance.np_fullscreen_note = Als je Speelt nu of de songtekst opent, gaat het venster naar volledig scherm; bij sluiten gaat het weer terug. Een venster dat al op volledig scherm stond, blijft zo.
settings.appearance.mini_player = Miniplayer

# ---- Playback
settings.playback.queue = Wachtrij
settings.playback.shuffle = Shuffle
settings.playback.shuffle_desc = Houdt het huidige nummer bovenaan; uitzetten herstelt de volgorde.
settings.playback.repeat = Herhalen
