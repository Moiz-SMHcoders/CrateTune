# ---- Welcome step
onboarding.feature.browse.title = Jelajahi & cari
onboarding.feature.browse.text = Beranda, tangga lagu, suasana, rilis baru, artis, album, dan playlist.
onboarding.feature.lyrics.title = Lirik
onboarding.feature.lyrics.text = Lirik yang disinkronkan per kata dari banyak penyedia, dengan terjemahan dan romanisasi.
onboarding.feature.library.title = Pustaka
onboarding.feature.library.text = Lagu yang disukai, playlist, riwayat mendengarkan, statistik, dan unduhan — disimpan di komputer ini.
onboarding.feature.recognize.title = Kenali musik
onboarding.feature.recognize.text = Kenali lagu yang diputar di sekitar Anda (⇧⌘R) dan langsung putar.

