# ---- Step subtitles
onboarding.subtitle.welcome = Pemutar native yang cepat untuk YouTube Music: jelajahi dan cari, lirik yang mengikuti lagu, pustaka dengan riwayat dan statistik, file musik Anda sendiri, serta pengenalan lagu. Cukup beberapa pilihan dan Anda siap — semuanya bisa diubah nanti di Pengaturan.
onboarding.subtitle.content = Bahasa yang digunakan YouTube Music untuk judul dan rekomendasi, serta tangga lagu dan rilisan negara mana yang Anda lihat.
onboarding.subtitle.theme = Pilih tema dan ukuran teks.
onboarding.subtitle.account = Opsional. Dengan masuk, Anda mendapatkan lagu yang disukai, pustaka, playlist, dan rekomendasi pribadi. Semua fitur lain berfungsi tanpa akun.
onboarding.subtitle.local_files = Opsional. Tambahkan folder berisi file musik; folder dipindai ke pustaka Anda dan diputar bersama YouTube Music.
onboarding.subtitle.privacy = Yang perlu diketahui sebelum memulai.

