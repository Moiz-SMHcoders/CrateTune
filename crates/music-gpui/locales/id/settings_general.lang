settings.account.sync_row = Sinkronkan pustaka YouTube Music Anda
settings.account.sync_row_desc = Lagu yang disukai, lagu pustaka, album tersimpan, langganan, playlist.
settings.account.accounts_group = Akun
settings.account.channels = Channel (akun brand) dari akun Google ini:
