# ---- Appearance
settings.appearance.theme = Design
settings.appearance.theme_note = „Dynamisch“ übernimmt die Akzentfarbe aus dem Cover des laufenden Titels (die häufigste kräftige Farbe, angepasst, damit sie auf dem dunklen Hintergrund lesbar bleibt).
settings.appearance.text_size = Textgröße
settings.appearance.font_scale = {percent} %
settings.appearance.text_size_note = Skaliert den gesamten Text der Oberfläche; Songtexte behalten ihre eigene Größe (Songtexte).
settings.appearance.background = Hintergrund
settings.appearance.np_note = Verlauf, Einfarbig und Leuchten übernehmen ihre Farben aus dem Cover. Das Leuchten bewegt sich nur, während Musik läuft. Layout und Hintergrund findest du auch im Layout-Menü von „Läuft gerade“.
settings.appearance.np_fullscreen = Vollbild beim Öffnen von „Läuft gerade“
settings.appearance.np_fullscreen_note = Wenn du „Läuft gerade“ oder den Songtext öffnest, wechselt das Fenster ins Vollbild; beim Schließen verlässt es das Vollbild wieder. Ein Fenster, das schon im Vollbild war, bleibt es.
settings.appearance.window_group = Fenster
settings.appearance.system_title_bar = Titelleiste des Systems verwenden
settings.appearance.system_title_bar_note = Zeigt die Titelleiste des Betriebssystems, mit Zurück, Vorwärts und Suche über der Seite, statt der oberen Leiste. Wirkt beim nächsten Start von {app}.
settings.appearance.title_bar_pending = Starte {app} neu, um die Titelleiste zu wechseln.
settings.appearance.mini_player = Miniplayer

# ---- Playback
settings.playback.queue = Warteschlange
settings.playback.shuffle = Zufallswiedergabe
settings.playback.shuffle_desc = Der aktuelle Song bleibt vorne; beim Ausschalten wird die Reihenfolge wiederhergestellt.
settings.playback.repeat = Wiederholen
settings.playback.repeat_desc = Bleibt zwischen Starts erhalten (⌘R schaltet durch).
settings.playback.repeat_all = Alle
settings.playback.repeat_one = Eins
settings.playback.audio = Audio
settings.playback.streams = YouTube-Streams
settings.playback.stream_auto = Ganze Songs: TV-Client, dann Web-Client mit PoToken, dann ca. 1 Min. Vorschau.
settings.playback.stream_tv = Ganze Songs über den TV-Client (ohne PoToken); bei Fehlern eine Vorschau.
settings.playback.stream_web = Ganze Songs über den Web-Client und ein BotGuard-PoToken (macOS / Windows); bei Fehlern eine Vorschau.
settings.playback.stream_preview = Nur die erste Minute (ca.) jedes Songs (das alte Verhalten).
settings.playback.quality = Streamingqualität
settings.playback.quality_desc = Niedrig spart Daten; Hoch bevorzugt Opus (~160 kbit/s) gegenüber AAC 128.
settings.playback.normalize = Lautstärke angleichen
settings.playback.normalize_desc = Gleicht die Lautstärke mit den Lautheitsdaten von YouTube und ReplayGain-Tags an.
settings.playback.skip_silence = Stille überspringen
settings.playback.skip_silence_desc = Entfernt Stille am Anfang und Ende von Titeln und kürzt lange stille Pausen.
settings.playback.auto_skip = Songs überspringen, die nicht laden
settings.playback.auto_skip_desc = Macht weiter, statt anzuhalten (bis zu 3 nacheinander).
settings.playback.transitions = Übergänge
settings.playback.crossfade = Überblenden
settings.playback.crossfade_value = {seconds} s
settings.playback.transitions_note = Die Wiedergabe ist lückenlos: Der nächste Song wird etwa 30 s im Voraus gepuffert und startet direkt mit dem nächsten Sample. Überblenden mischt die beiden (auch bevor eine Vorschau vorzeitig endet).
settings.playback.speed_pitch = Tempo und Tonhöhe
settings.playback.speed = Tempo
settings.playback.speed_value = {speed}×
settings.playback.pitch = Tonhöhe
settings.playback.pitch_value = {value} HT
settings.playback.speed_pitch_note = Das Tempo behält die Tonhöhe bei; die Tonhöhe behält das Tempo bei.
settings.playback.output = Ausgabegerät
settings.playback.system_default = Systemstandard
settings.playback.device_missing = {device} (nicht verbunden)
settings.playback.device_current_default = {device} (aktueller Standard)
settings.playback.playing_through = Wiedergabe über {device}
settings.playback.output_note = Fehlt ein Gerät, wird der Systemstandard genutzt; das Gerät wird wieder verwendet, sobald es zurück ist.
settings.playback.sleep = Sleep-Timer
settings.playback.sleep_custom_button = {minutes} Min. (eigene)
settings.playback.end_of_track = Ende des Titels
settings.playback.turn_off = Ausschalten
settings.playback.sleep_armed = Pausiert die Wiedergabe: {when}
settings.playback.custom_length = Eigene Dauer
settings.playback.sleep_note = Auch in der Player-Leiste und auf dem „Läuft gerade“-Bildschirm (Mondsymbol).

# ---- Equalizer
settings.eq.preset.flat = Neutral
settings.eq.preset.bass = Bass
settings.eq.preset.vocal = Gesang
settings.eq.preset.treble = Höhen
settings.eq.preset.loudness = Loudness
settings.eq.note = Wird live angewendet. Anhebungen werden ausgeglichen, damit die Ausgabe nie übersteuert.

# ---- Lyrics
settings.lyrics.look = Aussehen
settings.lyrics.animation = Animation
settings.lyrics.animation_note = Karaoke: sanfter Verlauf mit angehobenen Wörtern · Apple: breiterer Verlauf, leuchtendes Wort · Gleiten: scharfer Verlauf, Wörter gleiten nach oben · Leuchten: Schein um gesungene Wörter · Einblenden: Wörter blenden ein · Keine: die Zeile leuchtet auf. Wortanimationen brauchen wortgenaue Songtexte; bei zeilengenauen leuchtet die ganze Zeile.
settings.lyrics.text_size = Textgröße
settings.lyrics.text_size_value = {size} px
settings.lyrics.line_spacing = Zeilenabstand
settings.lyrics.line_spacing_value = {spacing}×
settings.lyrics.alignment = Ausrichtung
settings.lyrics.bg_vocals = Hintergrundgesang und Duette
settings.lyrics.bg_vocals_desc = Backgroundgesang unter seiner Zeile; eine zweite Stimme auf der anderen Seite.
settings.lyrics.providers = Anbieter
settings.lyrics.providers_note = Werden in dieser Reihenfolge gefragt (mehrere gleichzeitig); das beste Ergebnis gewinnt. Klick in „Läuft gerade“ auf eine Zeile, um dorthin zu springen; der Neu-laden-Button dort sucht erneut.
settings.lyrics.cached_only = ohne Schlüssel nur zwischengespeicherte Songs
settings.lyrics.needs_key = braucht einen API-Schlüssel
settings.lyrics.prefer_word = Wortgenaue Songtexte bevorzugen
settings.lyrics.prefer_word_desc = Ein wortgenaues Ergebnis schlägt ein zeilengenaues von einem weiter oben stehenden Anbieter.
settings.lyrics.reset_order = Reihenfolge zurücksetzen
settings.lyrics.keys_note = API-Schlüssel werden im Schlüsselbund gespeichert, wenn das Feld den Fokus verliert oder du die Eingabetaste drückst.
settings.lyrics.translation = Übersetzung
settings.lyrics.translate = Songtexte übersetzen
settings.lyrics.translate_desc = Fügt unter jeder Zeile eine übersetzte Zeile hinzu (auch über den Übersetzen-Button in „Läuft gerade“).
settings.lyrics.translator = Übersetzer
settings.lyrics.translator_ai = KI (OpenAI-kompatibel)
settings.lyrics.language = Sprache
settings.lyrics.endpoint = Endpunkt
settings.lyrics.model = Modell
settings.lyrics.api_key = API-Schlüssel
settings.lyrics.translation_note = Sprachcodes wie en, de, ja, zh-CN. Jeder Song wird pro Sprache und Übersetzer einmal übersetzt und in der Mediathek aufbewahrt. Der kostenlose Endpunkt von Google ist begrenzt: Nach einer Ablehnung wird er eine Weile in Ruhe gelassen (2 Min., länger bei wiederholter Ablehnung) und die Übersetzung dann erneut versucht.
settings.lyrics.ai_missing = Leg den KI-Endpunkt und das Modell unter Einstellungen → Songtexte fest.
settings.lyrics.romanization = Umschrift
settings.lyrics.romanization_note = Fügt unter Zeilen in diesen Schriften eine Zeile in lateinischer Schrift hinzu.
settings.lyrics.kanji = Kanji-Lesungen (Japanisch)
settings.lyrics.kanji_embedded = In dieser Version enthalten.
settings.lyrics.kanji_missing = Ohne sie bleiben Kanji unverändert und nur Kana werden umgeschrieben. Lädt einmalig {download} herunter ({disk} auf dem Datenträger).
settings.lyrics.kanji_download = Herunterladen ({size})
settings.lyrics.kanji_downloading = Wird heruntergeladen… {done} von {total}
settings.lyrics.kanji_ready = {name} · {size} auf dem Datenträger.
settings.lyrics.kanji_failed = Download fehlgeschlagen: {error}
