# Settings: Account, Network and About sections, the settings panel, the update
# check and the Google sign-in window.

# ---- Account
settings.account.cookie_title = Mit einem Browser-Cookie anmelden
settings.account.cookie_steps = 1. Öffne music.youtube.com in deinem Browser und melde dich an.\n2. Öffne die Entwicklertools ({keys} in {browsers}) → Netzwerk und lade die Seite neu.\n3. Klick auf eine beliebige Anfrage an music.youtube.com (z. B. „browse“), such unter Request Headers nach „Cookie“ und kopiere den gesamten Wert.\n4. Füg ihn unten ein. Er wird im Schlüsselbund des Systems gespeichert und nur an YouTube gesendet.
settings.account.cookie_index = Google-Kontoindex (falls mehrere angemeldet sind):
settings.account.not_signed_in = Nicht angemeldet. Alles funktioniert anonym; mit der Anmeldung werden deine Lieblingssongs, gespeicherten Alben, Abos und Playlists in die Mediathek synchronisiert, und Likes und Playlist-Änderungen gehen zurück an YouTube Music.
settings.account.sign_in_google = Mit Google anmelden…
settings.account.paste_cookie = Cookie einfügen…
settings.account.google_refused = Wenn Google das Anmeldefenster ablehnt („Dieser Browser oder diese App ist möglicherweise nicht sicher“), nutze „Cookie einfügen“.
settings.account.profile_note = Das Anmeldefenster hat ein eigenes Browserprofil, damit {app} deine Sitzung im Hintergrund erneuern kann. Beim Abmelden wird es gelöscht.
settings.account.last_synced = Zuletzt synchronisiert am {date}
settings.account.not_synced = Noch nicht synchronisiert
settings.account.sync_now = Abgleichen
settings.account.syncing = Gleicht ab…
settings.account.sync_group = Mediathek-Synchronisierung
settings.account.sync_row = Deine YouTube Music-Mediathek synchronisieren
settings.account.sync_row_desc = Lieblingssongs, Mediathek-Songs, gespeicherte Alben, Abos, Playlists.
settings.account.auto_sync = Automatisch mit YouTube Music synchronisieren
settings.account.auto_sync_desc = Beim Start, alle 45 Minuten und wenn du nach einer Weile zurückkommst: deine Lieblingssongs, alle 6 Stunden die ganze Mediathek. Ein Song, den du abspielst, übernimmt außerdem sein „Gefällt mir“ oder „Mag ich nicht“ von YouTube Music.
settings.account.skip_disliked = Songs überspringen, die du nicht magst
settings.account.skip_disliked_desc = Wenn du den laufenden Song mit „Mag ich nicht“ markierst, geht es mit dem nächsten weiter. Songs mit „Mag ich nicht“ bleiben in jedem Fall aus Radio und Autoplay draußen.
settings.account.accounts_group = Konten
settings.account.channels = Kanäle (Brand-Accounts) dieses Google-Kontos:
settings.account.google_index = Google-Konto
settings.account.google_index_desc = Deine Anmeldung kann mehrere Google-Konten enthalten, wie auf youtube.com. Wähle, welches {app} verwendet.
settings.account.google_single = Diese Anmeldung enthält ein Google-Konto. Für mehrere melde dich in einem Browser bei music.youtube.com mit jedem an, melde dich hier ab und füge das Cookie dieses Browsers ein.
settings.account.cookie_note = Die Anmeldung nutzt das Sitzungs-Cookie deines Browsers für music.youtube.com. Es wird im Schlüsselbund des Systems aufbewahrt und nur an YouTube gesendet. Die Kontofunktionen wurden gegen die Web-API von YouTube gebaut, aber noch nicht mit einem echten Konto geprüft.

