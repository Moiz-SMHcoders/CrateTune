# ---- Self-update (Settings → About → Updates, notifications, menu; src/update_check.rs,
# src/settings/about.rs). The older update.* keys are in settings_general.lang.

# Menu item (macOS: app menu under "About"; elsewhere: Help menu). Also a shortcut label.
menu.check_updates = Nach Updates suchen…

# Buttons. {version} = a version number such as 0.2.0.
update.update_to = Auf {version} aktualisieren
# Notification button: download and install the update that was found.
update.update_now = Aktualisieren
update.restart = Zum Abschließen neu starten
update.retry = Erneut versuchen
# Opens the release page in the browser.
update.download_manually = Manuell herunterladen

# Status lines.
# {progress} = update.progress, or just the amount downloaded ("12.3 MB").
update.downloading = {version} wird heruntergeladen… {progress}
# {done}, {total} = sizes such as "12.3 MB".
update.progress = {done} von {total}
update.ready = Version {version} ist heruntergeladen und geprüft. Starte neu, um das Update abzuschließen.
update.installing = {version} wird installiert…

# Switches.
update.auto_check = Automatisch nach Updates suchen
update.auto_check_detail = Beim Start von {app} und alle 24 Stunden, solange die App läuft.
update.auto_install = Updates automatisch installieren
update.auto_install_detail = Lädt Updates im Hintergrund herunter und bittet dich um einen Neustart. Beendest du die App stattdessen, wird das Update dabei installiert.
update.prereleases = Vorabversionen einbeziehen
update.prereleases_detail = Testversionen, die vor einer stabilen Version erscheinen. Standardmäßig aktiv, solange du eine Vorabversion verwendest (jede 0.x-Version).

# Notifications.
update.ready_toast = {app} {version} ist bereit. Starte neu, um das Update abzuschließen.
# {error} = one of the update.error.* messages.
update.failed_toast = Das Update ist fehlgeschlagen. {error}

# Errors, in plain words. "Nothing was installed" = the current version is unchanged.
# {error} = an English technical detail.
update.error.network = GitHub ist nicht erreichbar ({error}). Prüfe deine Internetverbindung oder deinen Proxy.
update.error.bad_response = GitHub hat eine unerwartete Antwort gesendet ({error}).
update.error.untrusted = Der Download-Link verweist nicht auf die GitHub-Releases dieser App und wurde daher nicht geöffnet.
update.error.no_asset = Dieses Release enthält kein Paket für dein System. Lade es manuell herunter.
update.error.no_checksums = Dieses Release hat keine Prüfsummendatei, daher kann der Download nicht überprüft werden. Es wurde nichts installiert.
update.error.not_listed = Die Prüfsummendatei des Release enthält dieses Paket nicht, daher kann es nicht überprüft werden. Es wurde nichts installiert.
update.error.mismatch = Der Download stimmt nicht mit der Prüfsumme des Release überein. Er wurde gelöscht und es wurde nichts installiert.
update.error.cancelled = Download abgebrochen.
# {path} = a folder.
update.error.not_writable = {app} kann sich nicht selbst ersetzen, weil dein Benutzer keine Schreibrechte für {path} hat. Lade die neue Version manuell herunter.
update.error.dev_build = Diese Kopie wurde nicht aus einem Release-Paket installiert (sie wurde z. B. aus dem Quellcode gebaut) und kann sich daher nicht selbst aktualisieren.
update.error.translocated = macOS führt diese Kopie von einem temporären, schreibgeschützten Ort aus. Bewege {app} in deinen Programme-Ordner, öffne die App von dort und versuche es erneut.
update.error.system_package = Diese Kopie wurde mit einem Paketmanager installiert. Aktualisiere sie dort.
update.managed = Updates kommen über {manager}.
update.managed_detail = {app} wurde mit {manager} installiert und aktualisiert sich daher nicht selbst. Aktualisiere es dort zusammen mit deinen anderen Apps.
update.error.invalid = Das heruntergeladene Paket ist ungültig ({error}). Es wurde nichts installiert.
update.error.io = Der Download konnte nicht gespeichert werden ({error}).
update.error.install = Die Installation ist fehlgeschlagen, die aktuelle Version bleibt erhalten ({error}).
