settings.spotify.client_id = Client ID
settings.spotify.redirect_port = Weiterleitungsport
settings.spotify.redirect_uri = Weiterleitungs-URI: {uri}
settings.spotify.steps = 1. Erstelle eine App unter developer.spotify.com/dashboard (Web API). 2. Füg ihr die obige Weiterleitungs-URI hinzu. 3. Füg hier ihre Client ID ein und klick auf „Verbinden“. Der Zugriff ist schreibgeschützt (deine Playlists und Lieblingssongs); der Refresh-Token wird im Schlüsselbund aufbewahrt.
settings.spotify.without_account = Ohne Konto
settings.spotify.without_account_note = Exportiere eine Playlist mit Exportify (exportify.app) und importiere die CSV-Datei unter Mediathek → Import & Export. Die Anmeldung mit dem sp_dc-Cookie des Webplayers (wie bei {other_app}) wird nicht unterstützt: Sie hängt von einem Geheimnis ab, das aus dem Webplayer von Spotify extrahiert wird.
settings.spotify.open_import = Import & Export öffnen
settings.spotify.error.no_client = Gib zuerst die Client ID deiner App ein.
settings.spotify.error.redirect = Weiterleitung kann nicht empfangen werden: {error}

