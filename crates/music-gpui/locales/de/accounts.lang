settings.account.from_browser = Mit deinem Browser anmelden…
settings.account.browser_note = „Mit deinem Browser anmelden“ übernimmt die YouTube-Anmeldung eines Browsers auf diesem Computer (Chrome, Edge, Brave, Firefox, Safari, Arc, Vivaldi, Opera, Chromium), damit du dich nicht erneut anmelden musst.
settings.account.in_use = Aktiv
settings.account.switch = Wechseln
settings.account.remove = Dieses Konto entfernen
settings.account.list_group = Deine Konten
settings.account.add = Konto hinzufügen
settings.account.add_desc = Melde dich bei einem weiteren YouTube-Music-Konto an; wechsle hier oder über das Kontomenü in der Titelleiste.
settings.account.list_note = Lieblingssongs, gespeicherte Alben, Abos und YouTube-Playlists gehören zum aktiven Konto und werden beim Wechsel neu synchronisiert. Lokale Dateien, lokale Playlists, Wiedergabeverlauf und Downloads teilen sich alle Konten.
settings.account.report_plays = Wiedergaben zu meinem YouTube-Verlauf hinzufügen
settings.account.report_plays_desc = Was du hier hörst, erscheint im YouTube-Music-Verlauf auf deinen anderen Geräten und verbessert die Empfehlungen. Bei pausiertem Hörverlauf wird nichts gesendet.
browser_import.title = Mit deinem Browser anmelden
browser_import.intro = Wähle ein Browserprofil, in dem du bei music.youtube.com angemeldet bist. {app} liest nur dessen youtube.com-Cookies, auf diesem Computer, und bewahrt sie wie jede Anmeldung im Schlüsselbund auf.
browser_import.note.keychain = macOS fragt, ob {app} „<browser> Safe Storage“ aus deinem Schlüsselbund verwenden darf. Das ist so gewollt: Es ist der Schlüssel zu den Cookies des Browsers. Wähle „Erlauben“.
browser_import.note.app_bound = Unter neueren Windows-Versionen sperren Chrome, Edge und Brave ihre Cookies für andere Apps (App-gebundene Verschlüsselung). Diese Profile werden angezeigt, können aber nicht gelesen werden; nutze stattdessen Firefox, „Mit Google anmelden…“ oder ein eingefügtes Cookie.
browser_import.none_found = Auf diesem Computer wurde kein unterstützter Browser mit gespeicherten Cookies gefunden.
browser_import.import = Importieren
browser_import.last_used = Zuletzt verwendet {date}
browser_import.blocked.app_bound = Vom Browser gesperrt (App-gebundene Verschlüsselung)
browser_import.blocked.no_key = Der Cookie-Schlüssel des Browsers wurde nicht gefunden
browser_import.blocked.full_disk_access = Braucht vollen Festplattenzugriff (Systemeinstellungen → Datenschutz & Sicherheit)
browser_import.reading = YouTube-Anmeldung wird aus {browser} gelesen…
browser_import.error.not_found = Der Cookie-Speicher von {browser} ist nicht mehr vorhanden.
browser_import.error.locked = {browser} sperrt seine Cookies, solange es läuft. Beende {browser} und versuche es erneut.
browser_import.error.full_disk_access = {app} braucht vollen Festplattenzugriff, um die Cookies von Safari zu lesen: Systemeinstellungen → Datenschutz & Sicherheit → Festplattenvollzugriff.
browser_import.error.permission = {app} darf die Cookies von {browser} nicht lesen.
browser_import.error.keychain = macOS hat „{browser} Safe Storage“, den Schlüssel zu den Cookies von {browser}, nicht herausgegeben. Versuche es erneut und wähle „Erlauben“, wenn macOS fragt.
browser_import.error.no_key = Der Schlüssel zu den Cookies von {browser} wurde nicht gefunden.
browser_import.error.app_bound = {browser} sperrt seine Cookies unter dieser Windows-Version für andere Apps (App-gebundene Verschlüsselung). Nutze stattdessen Firefox, „Mit Google anmelden…“ oder ein eingefügtes Cookie.
browser_import.error.decrypt = Die Cookies von {browser} konnten nicht entschlüsselt werden.
browser_import.error.not_signed_in = {browser} ({profile}) ist nicht bei YouTube angemeldet. Melde dich dort zuerst bei music.youtube.com an.
browser_import.error.format = Der Cookie-Speicher von {browser} konnte nicht gelesen werden.
