# ---- Welcome step: feature list
onboarding.feature.browse.title = Stöbern & Suchen
onboarding.feature.browse.text = Startseite, Charts, Stimmungen, Neuerscheinungen, Künstler, Alben und Playlists.
onboarding.feature.lyrics.title = Songtexte
onboarding.feature.lyrics.text = Wortgenau synchronisierte Songtexte von vielen Anbietern, mit Übersetzung und Umschrift.
onboarding.feature.library.title = Mediathek
onboarding.feature.library.text = Likes, Playlists, Hörverlauf, Statistiken und Downloads – gespeichert auf diesem Computer.
onboarding.feature.recognize.title = Musik erkennen
onboarding.feature.recognize.text = Erkenne einen Song, der um dich herum läuft (⇧⌘R), und spiel ihn sofort ab.

